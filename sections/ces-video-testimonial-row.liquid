{{ 'ces-base.css' | asset_url | stylesheet_tag }}
{{ 'ces-theme.css' | asset_url | stylesheet_tag }}
{{ 'ces-video-testimonial-row.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ces-video-testimonial-row.js' | asset_url }}" defer="defer"></script>

{% render 'ces-section-padding' %}

<div class="ces-section ces-video-testimonial-row ces-section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="ces-section__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="ces-section__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="ces-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="ces-subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ces-video-row
        class="ces-video-testimonial-row__list"
        style="--ces-video-ratio: {{ section.settings.aspect_ratio }};"
        role="list"
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign has_hosted_video = false
            if block.settings.video != blank
              assign has_hosted_video = true
            endif

            assign poster = block.settings.poster
            if poster == blank and has_hosted_video
              assign poster = block.settings.video.preview_image
            endif
          -%}

          <div class="ces-video-testimonial-row__item" role="listitem" {{ block.shopify_attributes }}>
            <div class="ces-video-testimonial-row__frame">
              {%- if has_hosted_video or block.settings.video_url != blank -%}
                <video
                  class="ces-video-testimonial-row__video"
                  playsinline
                  muted
                  loop
                  preload="none"
                  {% if poster != blank %}
                    poster="{{ poster | image_url: width: 800 }}"
                  {% endif %}
                  {% if block.settings.label != blank %}
                    aria-label="{{ block.settings.label | escape }}"
                  {% endif %}
                  data-ces-video
                >
                  {%- if has_hosted_video -%}
                    {%- for source in block.settings.video.sources -%}
                      {%- if source.format == 'mp4' -%}
                        <source data-src="{{ source.url }}" type="{{ source.mime_type }}">
                      {%- endif -%}
                    {%- endfor -%}
                  {%- else -%}
                    {%- comment -%}
                      A direct MP4 or HLS URL. Shopify's `video_url` setting only
                      accepts YouTube and Vimeo, so this is a plain text setting
                      pointing at a CDN file.
                    {%- endcomment -%}
                    <source data-src="{{ block.settings.video_url }}">
                  {%- endif -%}
                </video>

                <button
                  class="ces-video-testimonial-row__sound"
                  type="button"
                  aria-pressed="false"
                  data-ces-video-sound
                >
                  <span class="ces-visually-hidden" data-ces-video-sound-label>Unmute video</span>
                  <span class="ces-video-testimonial-row__sound-icon" aria-hidden="true"></span>
                </button>
              {%- else -%}
                <div class="ces-video-testimonial-row__placeholder">
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'ces-placeholder-svg' }}
                </div>
              {%- endif -%}
            </div>

            {%- if block.settings.label != blank -%}
              <p class="ces-video-testimonial-row__label">{{ block.settings.label }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </ces-video-row>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "CES Video testimonial row",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Short vertical customer videos. They start muted when they scroll into view and pause when they leave, so nothing downloads until it is needed."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See How Rovina Transforms Real Lives"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real customers, real routines, filmed on their own phones."
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Video shape",
      "options": [
        { "value": "9 / 16", "label": "Story (9:16)" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "1 / 1", "label": "Square (1:1)" }
      ],
      "default": "9 / 16"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "video_item",
      "name": "Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "A video uploaded to Shopify. Takes priority over the URL below."
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "External video URL",
          "info": "A direct link to an .mp4 or .m3u8 file on your own CDN. Used only when no Shopify video is selected."
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Poster image",
          "info": "Shown before the video loads. Defaults to the Shopify video's own thumbnail."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Caption",
          "default": "Maya, 34"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "CES Video testimonial row",
      "blocks": [
        { "type": "video_item", "settings": { "label": "Maya, 34" } },
        { "type": "video_item", "settings": { "label": "Daniel, 41" } },
        { "type": "video_item", "settings": { "label": "Priya, 29" } },
        { "type": "video_item", "settings": { "label": "Chris, 52" } }
      ]
    }
  ]
}
{% endschema %}
