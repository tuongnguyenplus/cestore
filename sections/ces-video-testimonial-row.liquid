{{ 'ces-base.css' | asset_url | stylesheet_tag }}
{{ 'ces-theme.css' | asset_url | stylesheet_tag }}
{{ 'ces-slider.css' | asset_url | stylesheet_tag }}
{{ 'ces-video-testimonial-row.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ces-slider.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'ces-video-testimonial-row.js' | asset_url }}" defer="defer"></script>

{% render 'ces-section-padding' %}

<div class="ces-section ces-video-testimonial-row{% if section.settings.background_pattern == 'dots' %} ces-section--dotted{% endif %} ces-section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="ces-section__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="ces-section__header">
        {%- if section.settings.heading != blank -%}
          {%- liquid
            assign ces_heading = section.settings.heading
            if section.settings.highlight != blank and ces_heading contains section.settings.highlight
              capture ces_hl
                echo '<span class="ces-video-testimonial-row__heading-accent">'
                echo section.settings.highlight
                echo '</span>'
              endcapture
              assign ces_heading = ces_heading | replace: section.settings.highlight, ces_hl
            endif
          -%}
          <h2 class="ces-heading">{{ ces_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="ces-subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ces-slider
        class="ces-video-testimonial-row__slider"
        data-dot-label="Go to video"
      >
      <ces-video-row
        class="ces-video-testimonial-row__list"
        style="
          --ces-video-ratio: {{ section.settings.aspect_ratio }};
          --ces-video-columns: {{ section.settings.columns_mobile }};
          --ces-video-columns-desktop: {{ section.settings.columns_desktop }};
        "
        data-ces-slider-track
        {% if section.settings.autoplay %}
          data-autoplay
        {% endif %}
        role="list"
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign has_hosted_video = false
            if block.settings.video != blank
              assign has_hosted_video = true
            endif

            assign poster = block.settings.poster
            if poster == blank and has_hosted_video
              assign poster = block.settings.video.preview_image
            endif
          -%}

          <div class="ces-video-testimonial-row__item" data-ces-slider-slide role="listitem" {{ block.shopify_attributes }}>
            <div class="ces-video-testimonial-row__frame">
              {%- if has_hosted_video or block.settings.video_url != blank -%}
                {%- comment -%}
                  webkit-playsinline covers older iOS, and disablepictureinpicture
                  keeps the clip out of PiP. Between those and the CSS that makes
                  the element ignore pointer input, a tap while swiping can no
                  longer hand the clip to the native fullscreen player.
                {%- endcomment -%}
                <video
                  class="ces-video-testimonial-row__video"
                  playsinline
                  webkit-playsinline="true"
                  disablepictureinpicture
                  muted
                  {% if section.settings.loop %}
                    loop
                  {% endif %}
                  preload="none"
                  {% if poster != blank %}
                    poster="{{ poster | image_url: width: 800 }}"
                  {% endif %}
                  {% if block.settings.label != blank %}
                    aria-label="{{ block.settings.label | escape }}"
                  {% endif %}
                  data-ces-video
                >
                  {%- if has_hosted_video -%}
                    {%- for source in block.settings.video.sources -%}
                      {%- if source.format == 'mp4' -%}
                        <source data-src="{{ source.url }}" type="{{ source.mime_type }}">
                      {%- endif -%}
                    {%- endfor -%}
                  {%- else -%}
                    {%- comment -%}
                      A direct MP4 or HLS URL. Shopify's `video_url` setting only
                      accepts YouTube and Vimeo, so this is a plain text setting
                      pointing at a CDN file.
                    {%- endcomment -%}
                    <source data-src="{{ block.settings.video_url }}">
                  {%- endif -%}
                </video>

                {%- if section.settings.show_controls -%}
                  <button
                    class="ces-video-testimonial-row__play"
                    type="button"
                    aria-pressed="false"
                    data-ces-video-play
                  >
                    <span class="ces-visually-hidden" data-ces-video-play-label>Play video</span>
                    <span class="ces-video-testimonial-row__play-icon" aria-hidden="true"></span>
                  </button>
                {%- endif -%}

                <button
                  class="ces-video-testimonial-row__sound"
                  type="button"
                  aria-pressed="false"
                  data-ces-video-sound
                >
                  <span class="ces-visually-hidden" data-ces-video-sound-label>Unmute video</span>
                  <svg class="ces-video-testimonial-row__sound-svg ces-video-testimonial-row__sound-svg--off" aria-hidden="true" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M11 5 6 9H3v6h3l5 4V5Z" fill="currentColor"/>
                    <path d="m16 9 4 6m0-6-4 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  </svg>
                  <svg class="ces-video-testimonial-row__sound-svg ces-video-testimonial-row__sound-svg--on" aria-hidden="true" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M11 5 6 9H3v6h3l5 4V5Z" fill="currentColor"/>
                    <path d="M15.5 8.5a5 5 0 0 1 0 7M18 6a8.5 8.5 0 0 1 0 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  </svg>
                </button>
              {%- else -%}
                <div class="ces-video-testimonial-row__placeholder">
                  {{ 'image' | placeholder_svg_tag: 'ces-placeholder-svg' }}
                </div>
              {%- endif -%}
            </div>

            {%- if block.settings.label != blank -%}
              <p class="ces-video-testimonial-row__label">{{ block.settings.label }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </ces-video-row>

        <div class="ces-slider__controls">
          <button class="ces-slider__arrow" type="button" data-ces-slider-prev>
            <span class="ces-visually-hidden">Previous video</span>
            {% render 'ces-icon', icon: 'chevron-left', size: '1.8rem' %}
          </button>
          <div class="ces-slider__dots" data-ces-slider-dots></div>
          <button class="ces-slider__arrow" type="button" data-ces-slider-next>
            <span class="ces-visually-hidden">Next video</span>
            {% render 'ces-icon', icon: 'chevron-right', size: '1.8rem' %}
          </button>
        </div>
      </ces-slider>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "CES Video testimonial row",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Short vertical customer videos. They start muted when they scroll into view and pause when they leave, so nothing downloads until it is needed."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See How Rovina™ Transforms Real Lives"
    },
    {
      "type": "text",
      "id": "highlight",
      "label": "Highlighted word",
      "info": "This word inside the heading is shown in the accent colour. Leave empty for none.",
      "default": "Rovina™"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real customers, real routines, filmed on their own phones."
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Videos per view on mobile",
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Videos per view on desktop",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Play automatically in view",
      "info": "Off means each clip waits for its play button.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Show a play / pause button",
      "default": true
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Video shape",
      "options": [
        {
          "value": "9 / 16",
          "label": "Story (9:16)"
        },
        {
          "value": "4 / 5",
          "label": "Portrait (4:5)"
        },
        {
          "value": "1 / 1",
          "label": "Square (1:1)"
        }
      ],
      "default": "9 / 16"
    },
    {
      "type": "select",
      "id": "background_pattern",
      "label": "Background pattern",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "dots",
          "label": "Dot grid"
        }
      ],
      "default": "dots"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "video_item",
      "name": "Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "A video uploaded to Shopify. Takes priority over the URL below."
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "External video URL",
          "info": "A direct link to an .mp4 or .m3u8 file on your own CDN. Used only when no Shopify video is selected."
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Poster image",
          "info": "Shown before the video loads. Defaults to the Shopify video's own thumbnail."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Caption",
          "default": "Maya, 34"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "CES Video testimonial row",
      "blocks": [
        {
          "type": "video_item",
          "settings": {
            "label": "Maya, 34"
          }
        },
        {
          "type": "video_item",
          "settings": {
            "label": "Daniel, 41"
          }
        },
        {
          "type": "video_item",
          "settings": {
            "label": "Priya, 29"
          }
        },
        {
          "type": "video_item",
          "settings": {
            "label": "Chris, 52"
          }
        }
      ]
    }
  ]
}
{% endschema %}
