{{ 'ces-base.css' | asset_url | stylesheet_tag }}
{{ 'ces-theme.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .ces-recog{color:rgb(var(--color-foreground));background:var(--gradient-background)}
  .ces-recog__list{margin:2.4rem 0 0;padding:0;list-style:none;display:grid;grid-template-columns:1fr;gap:0}
  .ces-recog__item{display:flex;align-items:flex-start;gap:1.2rem;padding:1.6rem 0;border-top:.1rem dashed var(--ces-border-color);font-size:1.6rem;line-height:1.5}
  .ces-recog__item:first-child{border-top:none}
  .ces-recog__mark{flex:0 0 auto;width:2.2rem;height:2.2rem;margin-top:.1rem;border-radius:50%;border:.15rem solid var(--ces-accent);color:var(--ces-accent);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:1.3rem;line-height:1}
  .ces-recog__closing{margin:2.4rem 0 0;font-size:1.7rem;line-height:1.55;font-weight:600}
  @media screen and (min-width:750px){.ces-recog__list{grid-template-columns:1fr 1fr;gap:0 3.2rem}
    .ces-recog__item:nth-child(2){border-top:none}}
{%- endstyle -%}

{% render 'ces-section-padding' %}

<div class="ces-section ces-recog ces-section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="ces-section__inner ces-section__inner--narrow">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="ces-section__header">
        {%- if section.settings.heading != blank -%}<h2 class="ces-heading">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="ces-subheading">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="ces-recog__list">
        {%- for block in section.blocks -%}
          {%- if block.settings.text != blank -%}
            <li class="ces-recog__item" {{ block.shopify_attributes }}>
              <span class="ces-recog__mark" aria-hidden="true">?</span>
              <span>{{ block.settings.text }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.closing != blank -%}
      <p class="ces-recog__closing">{{ section.settings.closing }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "CES Recognition",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "If you've started noticing this, it isn't just tiredness" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "textarea", "id": "closing", "label": "Closing line", "default": "That's not a willpower problem. It's the thin skin under your eyes changing — and it needs something built for exactly that." },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 40 }
  ],
  "blocks": [
    { "type": "item", "name": "Recognition point", "settings": [
      { "type": "text", "id": "text", "label": "Text", "default": "People ask if you slept badly — even on the mornings you slept fine." }
    ] }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "CES Recognition", "blocks": [
      { "type": "item", "settings": { "text": "People ask if you slept badly — even on the mornings you slept fine." } },
      { "type": "item", "settings": { "text": "Concealer used to cover it. Now it creases, cakes, and the shadow still shows through." } },
      { "type": "item", "settings": { "text": "On video calls and in photos, your eyes read older and more tired than you feel." } },
      { "type": "item", "settings": { "text": "You've tried more sleep, more water, cutting back — the puffiness softens, the shadow stays." } }
    ] }
  ]
}
{% endschema %}
