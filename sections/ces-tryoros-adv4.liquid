{%- endif -%}

<div class="bar">CEBEAM Under-Eye Reset &middot; {{ section.settings.guarantee_days }}-day money-back guarantee</div>

<header class="mast"><div class="wrap">
  <span class="brand">CEBEAM</span>
  <span class="kicker">{{ section.settings.desk_name }}</span>
</div></header>

<main class="wrap">

<!-- 1. HEADLINE -->
<section class="hero">
  <h1>{{ section.settings.headline }}</h1>
  {%- if section.settings.subheadline != blank -%}
    <p>{{ section.settings.subheadline }}</p>
  {%- endif -%}
</section>

<!-- 2. BYLINE -->
{%- if section.settings.author_name != blank -%}
