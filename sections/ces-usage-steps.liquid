{{ 'ces-base.css' | asset_url | stylesheet_tag }}
{{ 'ces-theme.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .ces-usage{color:rgb(var(--color-foreground));background:var(--gradient-background)}
  .ces-usage__grid{display:grid;grid-template-columns:1fr;gap:2.4rem;margin-top:2.8rem}
  .ces-usage__step{display:flex;flex-direction:column}
  .ces-usage__media{position:relative;aspect-ratio:1/1;border-radius:var(--ces-radius);overflow:hidden;background:var(--ces-surface);border:.1rem solid var(--ces-border-color);margin-bottom:1.4rem}
  .ces-usage__media img{width:100%;height:100%;object-fit:cover;display:block}
  .ces-usage__ph{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:var(--ces-muted);font-size:1.3rem;text-align:center;padding:1.6rem}
  .ces-usage__num{position:absolute;top:1rem;left:1rem;width:3.2rem;height:3.2rem;border-radius:50%;background:var(--ces-accent);color:rgb(var(--color-background));display:flex;align-items:center;justify-content:center;font-weight:800;font-size:1.6rem}
  .ces-usage__title{font-size:1.8rem;font-weight:700;margin:0 0 .6rem}
  .ces-usage__text{font-size:1.5rem;line-height:1.5;color:var(--ces-muted);margin:0}
  .ces-usage__note{margin:2.8rem 0 0;font-size:1.5rem;line-height:1.5;padding:1.4rem 1.8rem;background:var(--ces-surface);border-radius:var(--ces-radius);border:.1rem solid var(--ces-border-color)}
  @media screen and (min-width:750px){.ces-usage__grid{grid-template-columns:repeat(3,1fr)}}
{%- endstyle -%}

{% render 'ces-section-padding' %}

<div class="ces-section ces-usage ces-section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="ces-section__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="ces-section__header">
        {%- if section.settings.heading != blank -%}<h2 class="ces-heading">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="ces-subheading">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="ces-usage__grid">
        {%- assign n = 0 -%}
        {%- for block in section.blocks -%}
          {%- assign n = n | plus: 1 -%}
          <div class="ces-usage__step" {{ block.shopify_attributes }}>
            <div class="ces-usage__media">
              <span class="ces-usage__num" aria-hidden="true">{{ n }}</span>
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
              {%- else -%}
                <span class="ces-usage__ph">Step {{ n }} image</span>
              {%- endif -%}
            </div>
            {%- if block.settings.title != blank -%}<p class="ces-usage__title">{{ block.settings.title }}</p>{%- endif -%}
            {%- if block.settings.text != blank -%}<p class="ces-usage__text">{{ block.settings.text }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.note != blank -%}<p class="ces-usage__note">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "CES Usage Steps",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How to use it — the whole method takes about 15 seconds" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "textarea", "id": "note", "label": "Note under steps", "default": "The 7-day starter is 4 treatments in your first week. After that, one pair two nights a week is all it takes to hold it." },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 40 }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "title", "label": "Title", "default": "Start clean and dry" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "On clean, dry skin, peel one patch from its sealed pouch." }
    ] }
  ],
  "max_blocks": 5,
  "presets": [
    { "name": "CES Usage Steps", "blocks": [
      { "type": "step", "settings": { "title": "Start clean and dry", "text": "On clean, dry skin, peel one patch from its individually sealed pouch." } },
      { "type": "step", "settings": { "title": "Press and leave on", "text": "Place one under each eye and press for 10 seconds. Leave on at least 2 hours, or overnight." } },
      { "type": "step", "settings": { "title": "Peel in the morning", "text": "Remove and discard. Nothing to rinse, nothing on your face by breakfast." } }
    ] }
  ]
}
{% endschema %}
