<style>
.ces-lst{--teal:#1d5c5c;--teal-d:#164747;--ink:#18211f;--muted:#5d6b67;--line:#e7e1d8;--paper:#fff;--sand:#f6f2ec;--gold:#d99b2b;
  --serif:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,"Times New Roman",serif;
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:17px;line-height:1.6}
.ces-lst *{box-sizing:border-box}
.ces-lst img{max-width:100%;display:block}
.ces-lst mark{background:transparent;color:inherit;padding:0}
.ces-lst .wrap{max-width:1060px;margin:0 auto;padding:0 22px}
.ces-lst .bar{background:var(--teal);color:#eaf3f1;text-align:center;font-size:12.5px;letter-spacing:.02em;padding:9px 14px;font-weight:600}
.ces-lst .bar b{color:#fff}
.ces-lst .mast{border-bottom:1px solid var(--line);text-align:center;padding:16px 0 14px}
.ces-lst .mast .brand{font-family:var(--serif);font-size:24px;letter-spacing:.42em;font-weight:600;padding-left:.42em}
.ces-lst .mast .kicker{display:block;margin-top:5px;font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--muted)}
.ces-lst .hero{text-align:center;max-width:800px;margin:0 auto;padding:40px 22px 14px}
.ces-lst .stars{color:var(--gold);letter-spacing:2px;font-size:15px}
.ces-lst .rate{font-size:12.5px;color:var(--muted);margin:6px 0 16px;letter-spacing:.02em}
.ces-lst h1{font-family:var(--serif);font-weight:600;font-size:clamp(30px,5vw,46px);line-height:1.14;margin:6px 0 16px}
.ces-lst h1 em{font-style:italic;color:var(--teal)}
.ces-lst .dek{font-size:19px;color:#39453f;max-width:640px;margin:0 auto 22px}
.ces-lst .btn{display:inline-block;background:var(--teal);color:#fff;text-decoration:none;font-weight:700;letter-spacing:.04em;padding:16px 34px;border-radius:999px;font-size:15px;box-shadow:0 10px 24px rgba(29,92,92,.24);transition:.2s}
.ces-lst .btn:hover{background:var(--teal-d)}
.ces-lst .btn.big{padding:18px 42px;font-size:16px}
.ces-lst .reasons{padding:26px 0 8px}
.ces-lst .reason{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:center;padding:34px 0;border-top:1px solid var(--line)}
.ces-lst .reason:first-child{border-top:none}
.ces-lst .reason .media{order:2}
.ces-lst .reason:nth-child(even) .txt{order:2}
.ces-lst .reason:nth-child(even) .media{order:1}
.ces-lst .num{display:inline-block;font-size:12px;font-weight:800;letter-spacing:.14em;color:var(--teal);background:#eaf1ef;padding:5px 11px;border-radius:999px;margin:0 0 12px}
.ces-lst .reason h2{font-family:var(--serif);font-weight:600;font-size:26px;line-height:1.2;margin:0 0 12px}
.ces-lst .reason p{margin:0 0 12px;color:#2c3733}
.ces-lst .pull{border-left:3px solid var(--teal);background:var(--sand);padding:12px 16px;border-radius:0 10px 10px 0;font-family:var(--serif);font-style:italic;font-size:18px;color:#243330;margin:14px 0}
.ces-lst .media .card{background:linear-gradient(160deg,#eef3f1,#dfe8e5);border-radius:16px;aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;text-align:center;color:#6f7f7b;font-size:13px;box-shadow:0 18px 40px rgba(22,71,71,.12);border:1px solid #e3ece9;padding:20px}
.ces-lst .media img{border-radius:16px;box-shadow:0 18px 40px rgba(22,71,71,.12);width:100%}
.ces-lst .mini{display:inline-block;color:var(--teal);font-weight:700;text-decoration:none;border-bottom:2px solid #cfe0dc;padding-bottom:2px}
.ces-lst .offer{background:var(--teal);color:#eaf3f1;text-align:center;padding:52px 22px;margin-top:20px}
.ces-lst .offer h2{font-family:var(--serif);color:#fff;font-size:clamp(26px,4vw,36px);font-weight:600;margin:0 0 8px}
.ces-lst .offer .sub{color:#cfe3df;max-width:560px;margin:0 auto 22px}
.ces-lst .checks{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 26px;max-width:560px;margin:0 auto 26px;text-align:left;padding:0}
.ces-lst .checks li{list-style:none;position:relative;padding-left:30px;color:#eaf3f1;font-size:15px}
.ces-lst .checks li::before{content:"\2713";position:absolute;left:0;top:-1px;width:20px;height:20px;background:#fff;color:var(--teal);border-radius:50%;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center}
.ces-lst .offer .btn{background:#fff;color:var(--teal)}
.ces-lst .offer .btn:hover{background:#f0efe9}
.ces-lst .offer .rate2{margin-top:16px;color:#cfe3df;font-size:13px}
.ces-lst .offer .rate2 .stars{color:#ffd479}
.ces-lst .reviews{padding:52px 22px 40px;background:var(--sand)}
.ces-lst .reviews h3{font-family:var(--serif);text-align:center;font-size:28px;font-weight:600;margin:0 0 6px}
.ces-lst .reviews .subh{text-align:center;color:var(--muted);font-size:13px;margin:0 0 28px}
.ces-lst .rev-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;max-width:1000px;margin:0 auto}
.ces-lst .rev{background:#fff;border:1px solid var(--line);border-radius:14px;padding:20px}
.ces-lst .rev .stars{font-size:14px}
.ces-lst .rev p{font-size:14.5px;color:#33403c;margin:10px 0 14px}
.ces-lst .rev .who{font-size:13px;font-weight:700}
.ces-lst .rev .vf{font-size:11.5px;color:var(--teal);font-weight:700}
.ces-lst .legal{background:#fff;text-align:center;color:var(--muted);font-size:11.5px;padding:20px 22px 0}
@media(max-width:760px){
  .ces-lst .reason{grid-template-columns:1fr;gap:18px;padding:26px 0}
  .ces-lst .reason .media,.ces-lst .reason:nth-child(even) .media{order:1}
  .ces-lst .reason .txt,.ces-lst .reason:nth-child(even) .txt{order:2}
  .ces-lst .rev-grid{grid-template-columns:1fr}
  .ces-lst .checks{grid-template-columns:1fr}
}

.ces-lst .solution{padding:8px 0 6px}
.ces-lst .sol-grid{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:center;background:var(--sand);border:1px solid var(--line);border-radius:20px;padding:32px;margin:22px 0}
.ces-lst .sol-media img,.ces-lst .sol-media .card{border-radius:14px;width:100%}
.ces-lst .sol-media .card{background:linear-gradient(160deg,#eef3f1,#dfe8e5);aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;color:#6f7f7b;font-size:13px;border:1px solid #e3ece9}
.ces-lst .sol-txt h2{font-family:var(--serif);font-weight:600;font-size:27px;margin:8px 0 12px}
.ces-lst .sol-txt p{margin:0 0 12px;color:#2c3733}
.ces-lst .sol-txt .btn{margin-top:6px}
@media(max-width:760px){.ces-lst .sol-grid{grid-template-columns:1fr;gap:18px;padding:20px}}
</style>

<div class="ces-ad ces-lst ces-ad--listicle-women">
<div class="bar">Reader offer · <b>{{ section.settings.discount_pct }}% off</b> ends {{ section.settings.offer_end }} · <b>{{ section.settings.guarantee_days }}-day</b> money-back guarantee</div>

<header class="mast"><div class="wrap"><span class="brand">{{ section.settings.brand_name }}</span><span class="kicker">{{ section.settings.brand_kicker }}</span></div></header>

<section class="hero">
  <div class="stars">★★★★★</div>
  <div class="rate">{{ section.settings.rating_value }} / 5 · {{ section.settings.rating_count }} verified reviews</div>
  <h1>{{ section.settings.hero_heading }}</h1>
  <p class="dek">{{ section.settings.hero_sub }}</p>
  <a class="btn" href="#ces-offer">{{ section.settings.hero_cta_label }}</a>
</section>

<div class="wrap"><div class="reasons">
{%- for block in section.blocks -%}{%- if block.type == 'reason' -%}
<div class="reason" {{ block.shopify_attributes }}>
  <div class="txt"><span class="num">{{ block.settings.num }}</span>
    <h2>{{ block.settings.heading }}</h2>
    {{ block.settings.body }}
    {%- if block.settings.pull != blank -%}<div class="pull">{{ block.settings.pull }}</div>{%- endif -%}
    {%- if block.settings.show_link -%}<a class="mini" href="#ces-offer">{{ block.settings.link_label }}</a>{%- endif -%}
  </div>
  <figure class="media">{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 1400 }}" alt="CEBEAM Microneedle Patches" loading="lazy" style="width:100%;height:auto;display:block">{%- else -%}<div class="card">CEBEAM image</div>{%- endif -%}</figure>
</div>
{%- endif -%}{%- endfor -%}
</div></div>


<section class="solution"><div class="wrap"><div class="sol-grid">
  <div class="sol-media">{% if section.settings.product_image != blank %}<img src="{{ section.settings.product_image | image_url: width: 1200 }}" alt="CEBEAM Microneedle Patches" loading="lazy" style="width:100%;height:auto;display:block">{% else %}<div class="card">CEBEAM product shot</div>{% endif %}</div>
  <div class="sol-txt">
    <span class="num">THE FIX</span>
    <h2>{{ section.settings.solution_heading }}</h2>
    {{ section.settings.solution_body }}
    <a class="btn" href="#ces-offer">{{ section.settings.solution_cta_label }}</a>
  </div>
</div></div></section>

<section class="offer" id="ces-offer">
  <h2>{{ section.settings.offer_heading }}</h2>
  <p class="sub">{{ section.settings.offer_sub }}</p>
  <ul class="checks">
    {%- assign ces_checks = section.settings.offer_checklist | strip | newline_to_br | split: '<br />' -%}
    {%- for c in ces_checks -%}{%- assign cc = c | strip -%}{%- if cc != blank -%}<li>{{ cc }}</li>{%- endif -%}{%- endfor -%}
  </ul>
  <a class="btn big" href="{{ section.settings.cta_url | default: '/products/rovina' }}">{{ section.settings.offer_cta_label }}</a>
  <div class="rate2"><span class="stars">★★★★★</span> &nbsp;Rated {{ section.settings.rating_value }}/5 by {{ section.settings.rating_count }} customers</div>
</section>

<section class="reviews">
  <h3>{{ section.settings.reviews_heading }}</h3>
  <p class="subh">{{ section.settings.reviews_sub }}</p>
  <div class="rev-grid"><div class="rev"><div class="stars">★★★★★</div><p>{{ section.settings.r1_quote }}</p><div class="who">{{ section.settings.r1_name }}</div><div class="vf">✓ Verified buyer</div></div><div class="rev"><div class="stars">★★★★★</div><p>{{ section.settings.r2_quote }}</p><div class="who">{{ section.settings.r2_name }}</div><div class="vf">✓ Verified buyer</div></div><div class="rev"><div class="stars">★★★★★</div><p>{{ section.settings.r3_quote }}</p><div class="who">{{ section.settings.r3_name }}</div><div class="vf">✓ Verified buyer</div></div></div>
</section>

{%- if section.settings.legal_company != blank -%}<div class="legal">{{ section.settings.legal_company }}</div>{%- endif -%}
{% render 'ces-ad-disclaimer', show: section.settings.show_disclaimer, text: section.settings.disclaimer_text, copyright: section.settings.copyright_text %}
</div>

