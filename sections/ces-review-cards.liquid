<script src="{{ 'ces-review-carousel.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign rc_cards = section.blocks | where: 'type', 'review'
  assign rc_rating = section.settings.rating_tenths | default: 0
  assign rc_pct = rc_rating | times: 2
  assign rc_stars = rc_rating | divided_by: 10.0
  assign rc_pages = rc_cards.size | divided_by: section.settings.columns
  assign rc_rem = rc_cards.size | modulo: section.settings.columns
  if rc_rem > 0
    assign rc_pages = rc_pages | plus: 1
  endif
-%}

{%- style -%}
  .ces-rc{color:rgb(var(--color-foreground));background:var(--gradient-background)}
  .ces-rc__head{text-align:center}
  .ces-rc__rating{display:flex;align-items:center;justify-content:center;gap:.8rem;
    margin:0 0 1.2rem;flex-wrap:wrap}
  .ces-rc__stars{position:relative;display:inline-block;line-height:0}
  .ces-rc__stars-track{display:block;color:rgba(var(--color-foreground),.18)}
  /* Clipped to the score, so it must not be a flex container or the stars
     inside would shrink instead of being cut off. */
  .ces-rc__stars-fill{position:absolute;top:0;left:0;width:var(--ces-rating-pct,100%);
    overflow:hidden;color:var(--ces-star);white-space:nowrap}
  .ces-rc__stars svg{display:inline-block;vertical-align:top}
  .ces-rc__rating-text{font-size:1.5rem;font-weight:500;line-height:1.3}

  .ces-rc__slider{position:relative;display:flex;align-items:center;gap:1rem;margin-top:2.4rem}
  /* A scroll-snap track rather than a translated strip: swiping, momentum and
     keyboard scrolling then work with no script at all. */
  .ces-rc__track{flex:1;display:flex;gap:1.6rem;overflow-x:auto;scroll-snap-type:x mandatory;
    scrollbar-width:none;-webkit-overflow-scrolling:touch;scroll-behavior:smooth}
  .ces-rc__track::-webkit-scrollbar{display:none}
  .ces-rc__card{flex:0 0 100%;scroll-snap-align:start;display:flex;flex-direction:column;
    text-align:left;overflow:hidden;border-radius:2rem;
    background:var(--ces-card-bg,var(--ces-surface));
    border:.1rem {{ section.settings.card_border_style }} var(--ces-card-border,var(--ces-accent))}
  .ces-rc__media{position:relative;margin:0;width:100%;height:{{ section.settings.image_height | times: 0.8 | round }}px;
    overflow:hidden;background:var(--ces-surface-strong)}
  .ces-rc__media img{width:100%;height:100%;object-fit:cover;display:block}
  .ces-rc__tag{position:absolute;top:1.2rem;right:1.4rem;z-index:2;
    font-size:1.6rem;font-weight:800;letter-spacing:.04em;color:#fff;
    text-shadow:0 .1rem .6rem rgba(0,0,0,.45)}
  .ces-rc__body{padding:2.2rem 1.8rem 2rem;display:flex;flex-direction:column;gap:1rem;flex:1}
  .ces-rc__text{font-size:1.5rem;line-height:1.55;flex:1}
  .ces-rc__text > :first-child{margin-top:0}
  .ces-rc__text > :last-child{margin-bottom:0}
  .ces-rc__name{margin:.4rem 0 0;font-size:1.4rem;font-weight:700;line-height:1.35}
  .ces-rc__foot{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;
    padding-top:1rem;border-top:.1rem solid rgba(var(--color-foreground),.1)}
  .ces-rc__verified{display:inline-flex;align-items:center;gap:.6rem;flex:1;font-size:1.4rem}
  .ces-rc__verified .ces-icon{width:1.6rem;height:1.6rem;color:var(--ces-accent)}
  .ces-rc__card-stars{display:flex;gap:.2rem;flex-shrink:0;color:var(--ces-star)}
  .ces-rc__card-stars svg{display:block}

  .ces-rc__nav{flex-shrink:0;width:4.2rem;height:4.2rem;border-radius:50%;
    border:.1rem solid var(--ces-accent);background:rgb(var(--color-background));
    color:var(--ces-accent);display:flex;align-items:center;justify-content:center;
    cursor:pointer;padding:0;transition:background .2s ease,color .2s ease,opacity .2s ease}
  .ces-rc__nav:hover:not(:disabled){background:var(--ces-accent);color:rgb(var(--color-background))}
  .ces-rc__nav:disabled{opacity:.35;cursor:default}
  .ces-rc__nav svg{width:2.2rem;height:2.2rem}
  .ces-rc__dots{display:flex;justify-content:center;gap:.8rem;margin-top:2.4rem;padding:0;list-style:none}
  .ces-rc__dot{width:.8rem;height:.8rem;padding:0;border:0;border-radius:50%;
    background:rgba(var(--color-foreground),.22);cursor:pointer;transition:background .2s ease}
  .ces-rc__dot.is-active{background:var(--ces-accent)}
  /* Nothing to page through, nothing to show. */
  .ces-rc--single .ces-rc__nav,.ces-rc--single .ces-rc__dots{display:none}
  .ces-rc__disclaimer{margin:2rem 0 0;font-size:1.35rem;line-height:1.5;font-style:italic;
    color:var(--ces-muted)}
  @media screen and (min-width:750px){
    .ces-rc__card{flex:0 0 calc((100% - (var(--ces-rc-cols) - 1) * 1.6rem) / var(--ces-rc-cols))}
    .ces-rc__media{height:{{ section.settings.image_height }}px}
    .ces-rc__rating-text{font-size:1.6rem}
  }
{%- endstyle -%}

{% render 'ces-section-padding' %}

<div
  class="ces-section ces-rc ces-section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient"
  style="--ces-rc-cols: {{ section.settings.columns }};{% if section.settings.card_bg != blank %}--ces-card-bg: {{ section.settings.card_bg }};{% endif %}{% if section.settings.card_border != blank %}--ces-card-border: {{ section.settings.card_border }};{% endif %}"
>
  <div class="ces-section__inner">
    <div class="ces-rc__head">
      {%- if rc_rating > 0 or section.settings.rating_text != blank -%}
        <div class="ces-rc__rating">
          {%- if rc_rating > 0 -%}
            <span class="ces-rc__stars" style="--ces-rating-pct: {{ rc_pct }}%;" role="img" aria-label="{{ rc_stars }} out of 5 stars">
              <span class="ces-rc__stars-track" aria-hidden="true">
                {%- for i in (1..5) -%}{% render 'ces-icon', icon: 'star-filled', size: '1.8rem' %}{%- endfor -%}
              </span>
              <span class="ces-rc__stars-fill" aria-hidden="true">
                {%- for i in (1..5) -%}{% render 'ces-icon', icon: 'star-filled', size: '1.8rem' %}{%- endfor -%}
              </span>
            </span>
          {%- endif -%}
          {%- if section.settings.rating_text != blank -%}
            <span class="ces-rc__rating-text">{{ section.settings.rating_text }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ces-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="ces-subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if rc_cards.size > 0 -%}
      <ces-review-carousel>
        <div class="ces-rc__slider">
          <button class="ces-rc__nav" type="button" data-ces-rc-prev aria-label="{{ section.settings.prev_label | escape }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>

          <div class="ces-rc__track" data-ces-rc-track tabindex="0" role="group" aria-label="{{ section.settings.heading | escape }}">
            {%- for block in rc_cards -%}
              {%- liquid
                assign card_rating = block.settings.rating_tenths | default: 0
                assign card_stars = card_rating | divided_by: 10.0 | ceil
              -%}
              <article class="ces-rc__card" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  <figure class="ces-rc__media">
                    {%- if block.settings.tag != blank -%}
                      <span class="ces-rc__tag">{{ block.settings.tag }}</span>
                    {%- endif -%}
                    {%- assign rc_img_alt = block.settings.name | escape -%}
                    {% render 'ces-img',
                       image: block.settings.image,
                       alt: rc_img_alt,
                       sizes: '(min-width: 750px) 33vw, 85vw',
                       max: 860 %}
                  </figure>
                {%- endif -%}

                <div class="ces-rc__body">
                  {%- if block.settings.quote != blank -%}
                    <div class="ces-rc__text ces-rte">{{ block.settings.quote }}</div>
                  {%- endif -%}
                  {%- if block.settings.name != blank -%}
                    <p class="ces-rc__name">{{ block.settings.name }}</p>
                  {%- endif -%}
                  {%- if block.settings.verified or card_rating > 0 -%}
                    <div class="ces-rc__foot">
                      {%- if block.settings.verified -%}
                        <span class="ces-rc__verified">
                          {% render 'ces-icon', icon: 'check-circle', size: '1.6rem' %}
                          {{ section.settings.verified_label }}
                        </span>
                      {%- endif -%}
                      {%- if card_rating > 0 -%}
                        <span class="ces-rc__card-stars" role="img" aria-label="{{ block.settings.rating_tenths | divided_by: 10.0 }} out of 5 stars">
                          {%- for i in (1..card_stars) -%}
                            {% render 'ces-icon', icon: 'star-filled', size: '1.4rem' %}
                          {%- endfor -%}
                        </span>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              </article>
            {%- endfor -%}
          </div>

          <button class="ces-rc__nav" type="button" data-ces-rc-next aria-label="{{ section.settings.next_label | escape }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>

        {%- if rc_pages > 1 -%}
          <ul class="ces-rc__dots" role="list">
            {%- for i in (1..rc_pages) -%}
              <li>
                <button class="ces-rc__dot" type="button" data-ces-rc-dot
                        aria-label="{{ section.settings.page_label }} {{ i }}"></button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </ces-review-carousel>
    {%- endif -%}

    {%- if section.settings.disclaimer != blank -%}
      <p class="ces-rc__disclaimer">{{ section.settings.disclaimer }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "CES Review cards",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "A sliding row of review cards, each led by one picture. A single animated or split image can carry the before and after on its own." },
    { "type": "range", "id": "rating_tenths", "min": 0, "max": 50, "step": 1, "label": "Rating above the heading (tenths)", "info": "48 = 4.8. Set to 0 to hide the stars.", "default": 0 },
    { "type": "text", "id": "rating_text", "label": "Text beside those stars", "info": "Use your own review count." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Visible Changes Our Customers Love" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "header", "content": "The cards" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Cards across on desktop", "default": 3 },
    { "type": "range", "id": "image_height", "min": 180, "max": 460, "step": 10, "unit": "px", "label": "Picture height on desktop", "info": "Four fifths of this on a phone.", "default": 320 },
    { "type": "color", "id": "card_bg", "label": "Card background" },
    { "type": "color", "id": "card_border", "label": "Card border" },
    {
      "type": "select",
      "id": "card_border_style",
      "label": "Card border style",
      "options": [
        { "value": "dashed", "label": "Dashed" },
        { "value": "solid", "label": "Solid" }
      ],
      "default": "dashed"
    },
    { "type": "text", "id": "verified_label", "label": "Verified wording", "default": "Verified Buyer" },
    { "type": "header", "content": "Wording read out by screen readers" },
    { "type": "text", "id": "prev_label", "label": "Previous button", "default": "Previous reviews" },
    { "type": "text", "id": "next_label", "label": "Next button", "default": "Next reviews" },
    { "type": "text", "id": "page_label", "label": "Dot", "default": "Page" },
    { "type": "header", "content": "Below the cards" },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "Real customers, unretouched, shared with permission. Individual results vary." },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 40 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Picture", "info": "One picture per card. An animated or split before-and-after works here." },
        { "type": "text", "id": "tag", "label": "Label over the picture", "info": "For example AFTER. Leave empty for none." },
        { "type": "richtext", "id": "quote", "label": "What they said" },
        { "type": "text", "id": "name", "label": "Who said it", "info": "Use only a real, nameable customer." },
        { "type": "checkbox", "id": "verified", "label": "Show the verified mark", "default": true },
        { "type": "range", "id": "rating_tenths", "min": 0, "max": 50, "step": 1, "label": "Their rating (tenths)", "default": 50 }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "CES Review cards",
      "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }]
    }
  ]
}
{% endschema %}
