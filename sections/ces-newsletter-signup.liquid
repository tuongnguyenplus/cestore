{%- comment -%}
  Reuses Dawn's own newsletter form markup and classes, so the field, button and
  validation states inherit component-newsletter.css and stay consistent with
  the rest of the theme. ces-newsletter-signup.css only adds this section's
  layout: an optional background image and the centred panel over it.
{%- endcomment -%}

{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'ces-base.css' | asset_url | stylesheet_tag }}
{{ 'ces-theme.css' | asset_url | stylesheet_tag }}
{{ 'ces-newsletter-signup.css' | asset_url | stylesheet_tag }}

{% render 'ces-section-padding' %}

<div
  class="ces-section ces-newsletter-signup ces-section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient{% if section.settings.background_image != blank %} ces-newsletter-signup--has-image{% endif %}"
  style="--ces-newsletter-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  {%- if section.settings.background_image != blank -%}
    <div class="ces-newsletter-signup__background">
      {{
        section.settings.background_image
        | image_url: width: 2400
        | image_tag:
          loading: 'lazy',
          width: section.settings.background_image.width,
          height: section.settings.background_image.height,
          widths: '450, 750, 1100, 1500, 1900, 2400',
          sizes: '100vw',
          class: 'ces-newsletter-signup__background-image',
          alt: ''
      }}
    </div>
  {%- endif -%}

  <div class="ces-section__inner ces-section__inner--narrow">
    <div class="ces-newsletter-signup__panel">
      {%- if section.settings.heading != blank -%}
        <h2 class="ces-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="ces-newsletter-signup__text rte ces-rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {% form 'customer', class: 'newsletter-form ces-newsletter-signup__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="newsletter-form__field-wrapper">
          <div class="field">
            <input
              id="CesNewsletterForm--{{ section.id }}"
              type="email"
              name="contact[email]"
              class="field__input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              {% if form.errors %}
                autofocus
                aria-invalid="true"
                aria-describedby="CesNewsletter-error--{{ section.id }}"
              {% elsif form.posted_successfully? %}
                aria-describedby="CesNewsletter-success--{{ section.id }}"
              {% endif %}
              placeholder="{{ 'newsletter.label' | t }}"
              required
            >
            <label class="field__label" for="CesNewsletterForm--{{ section.id }}">
              {{ 'newsletter.label' | t }}
            </label>
            <button
              type="submit"
              class="newsletter-form__button field__button"
              name="commit"
              aria-label="{{ 'newsletter.button_label' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-arrow.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>

          {%- if form.errors -%}
            <small class="newsletter-form__message form__message" id="CesNewsletter-error--{{ section.id }}">
              <span class="svg-wrapper">
                {{- 'icon-error.svg' | inline_asset_content -}}
              </span>
              {{- form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email -}}
            </small>
          {%- endif -%}
        </div>

        {%- if form.posted_successfully? -%}
          <h3
            class="newsletter-form__message newsletter-form__message--success form__message"
            id="CesNewsletter-success--{{ section.id }}"
            tabindex="-1"
            autofocus
          >
            <span class="svg-wrapper">
              {{- 'icon-success.svg' | inline_asset_content -}}
            </span>
            {{- 'newsletter.success' | t }}
          </h3>
        {%- endif -%}
      {% endform %}

      {%- if section.settings.footnote != blank -%}
        <p class="ces-newsletter-signup__footnote">{{ section.settings.footnote }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CES Newsletter signup",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Subscribers are added to your Shopify customer list, tagged 'newsletter'."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join The Rovina Community"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Research summaries, honest product updates and subscriber-only offers. One email a week, and you can leave whenever you like.</p>"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Text below the form",
      "default": "No spam. Unsubscribe in one click."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Background overlay opacity",
      "info": "Only applies when a background image is set.",
      "default": 50
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "CES Newsletter signup"
    }
  ]
}
{% endschema %}
