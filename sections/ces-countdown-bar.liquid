<script src="{{ 'ces-countdown.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'ces-scroll.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign cd_deadline = section.settings.deadline | strip
  if section.settings.mode == 'deadline' and cd_deadline != blank
    assign cd_use_deadline = true
  else
    assign cd_use_deadline = false
  endif

  # The server-rendered first frame. In deadline mode the real remaining time is
  # not knowable here — the shopper's clock decides — so the boxes start at the
  # full window and ces-countdown.js corrects them on its first tick.
  if cd_use_deadline
    assign cd_seconds = 0
  else
    assign cd_seconds = section.settings.rolling_minutes | times: 60
  endif

  # Liquid filters chain left to right, so each remainder needs its own assign
  # rather than a single expression.
  assign cd_d = 0
  if section.settings.show_days
    assign cd_d = cd_seconds | divided_by: 86400
    assign cd_whole_days = cd_d | times: 86400
    assign cd_seconds = cd_seconds | minus: cd_whole_days
  endif

  assign cd_h = cd_seconds | divided_by: 3600
  assign cd_whole_hours = cd_h | times: 3600
  assign cd_rem = cd_seconds | minus: cd_whole_hours
  assign cd_m = cd_rem | divided_by: 60
  assign cd_s = 0
-%}

{%- capture cd_boxes -%}
  {%- if section.settings.show_days -%}
    <div class="ces-cd__group">
      <span class="ces-cd__box" data-ces-cd-days>{{ cd_d | prepend: '0' | slice: -2, 2 }}</span>
      <span class="ces-cd__label">{{ section.settings.days_label }}</span>
    </div>
    <span class="ces-cd__colon" aria-hidden="true">:</span>
  {%- endif -%}
  <div class="ces-cd__group">
    <span class="ces-cd__box" data-ces-cd-hours>{{ cd_h | prepend: '0' | slice: -2, 2 }}</span>
    <span class="ces-cd__label">{{ section.settings.hours_label }}</span>
  </div>
  <span class="ces-cd__colon" aria-hidden="true">:</span>
  <div class="ces-cd__group">
    <span class="ces-cd__box" data-ces-cd-minutes>{{ cd_m | prepend: '0' | slice: -2, 2 }}</span>
    <span class="ces-cd__label">{{ section.settings.minutes_label }}</span>
  </div>
  <span class="ces-cd__colon" aria-hidden="true">:</span>
  <div class="ces-cd__group">
    <span class="ces-cd__box" data-ces-cd-seconds>{{ cd_s | prepend: '0' | slice: -2, 2 }}</span>
    <span class="ces-cd__label">{{ section.settings.seconds_label }}</span>
  </div>
{%- endcapture -%}

{%- style -%}
  .ces-cd{color:rgb(var(--color-foreground));background:var(--gradient-background)}
  .ces-cd__inner{display:flex;flex-direction:column;align-items:center;gap:.8rem;
    padding:1rem 1.6rem;text-align:center}
  .ces-cd__copy{display:flex;flex-direction:column;gap:.2rem}
  .ces-cd__heading{margin:0;font-size:1.3rem;font-weight:700;letter-spacing:.08em;
    text-transform:uppercase;line-height:1.2}
  .ces-cd__sub{margin:0;font-size:1.5rem;font-weight:700;line-height:1.25}
  .ces-cd__clock{display:flex;align-items:flex-start;justify-content:center;gap:.5rem}
  .ces-cd__group{display:flex;flex-direction:column;align-items:center;gap:.3rem}
  /* Tabular figures stop the boxes twitching wider as the digits change. */
  .ces-cd__box{min-width:3.6rem;padding:.4rem .6rem;border-radius:.6rem;
    background:rgb(var(--color-background));color:rgb(var(--color-foreground));
    font-size:1.8rem;font-weight:700;line-height:1.1;font-variant-numeric:tabular-nums;
    font-feature-settings:"tnum"}
  .ces-cd__label{font-size:1rem;letter-spacing:.1em;text-transform:uppercase;opacity:.85;line-height:1}
  .ces-cd__colon{font-size:1.8rem;font-weight:700;line-height:1.3}
  .ces-cd__expired{margin:0;font-size:1.5rem;font-weight:700;line-height:1.3}
  .ces-cd__cta{margin-top:.2rem;font-size:1.3rem;font-weight:700;text-underline-offset:.3rem}
  @media screen and (min-width:750px){
    .ces-cd__inner{flex-direction:row;justify-content:center;gap:2.4rem;padding:1.2rem 2rem}
    .ces-cd__copy{text-align:left}
    .ces-cd__heading{font-size:1.4rem}
    .ces-cd__sub{font-size:1.8rem}
    .ces-cd__box{min-width:4.2rem;font-size:2.2rem}
    .ces-cd__colon{font-size:2.2rem}
  }
{%- endstyle -%}

{% render 'ces-section-padding' %}

<ces-countdown
  class="ces-section ces-cd ces-section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient"
  {% if cd_use_deadline %}
    data-deadline="{{ cd_deadline | escape }}"
  {% else %}
    data-minutes="{{ section.settings.rolling_minutes }}"
    data-key="ces-cd-{{ section.id }}"
  {% endif %}
>
  <div class="ces-cd__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="ces-cd__copy">
        {%- if section.settings.heading != blank -%}
          <p class="ces-cd__heading">{{ section.settings.heading }}</p>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="ces-cd__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="ces-cd__clock" data-ces-cd-clock>{{ cd_boxes }}</div>

    {%- if section.settings.expired_text != blank -%}
      <p class="ces-cd__expired" data-ces-cd-expired hidden>{{ section.settings.expired_text }}</p>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <a class="ces-cd__cta" href="{{ section.settings.cta_url | default: '#' }}">{{ section.settings.cta_label }}</a>
    {%- endif -%}
  </div>
</ces-countdown>

{% schema %}
{
  "name": "CES Countdown bar",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Eyebrow", "default": "Limited Time Flash Sale" },
    { "type": "text", "id": "subheading", "label": "Headline", "default": "Save up to 48% + Free Shipping" },
    { "type": "header", "content": "The clock" },
    {
      "type": "select",
      "id": "mode",
      "label": "Count down to",
      "options": [
        { "value": "deadline", "label": "A fixed date and time" },
        { "value": "rolling", "label": "A window per shopper" }
      ],
      "info": "A fixed date is the same for everyone and stops when it passes. A per-shopper window is saved in their browser, so refreshing the page carries on rather than starting over.",
      "default": "deadline"
    },
    { "type": "text", "id": "deadline", "label": "End date and time", "info": "Store time zone, as 2026-10-31 23:59." },
    { "type": "range", "id": "rolling_minutes", "min": 15, "max": 1440, "step": 15, "unit": "min", "label": "Window per shopper", "info": "Shopify allows at most 101 positions on a slider, so this moves in quarter hours.", "default": 60 },
    { "type": "checkbox", "id": "show_days", "label": "Show a days box", "default": false },
    { "type": "text", "id": "days_label", "label": "Days label", "default": "DAYS" },
    { "type": "text", "id": "hours_label", "label": "Hours label", "default": "HRS" },
    { "type": "text", "id": "minutes_label", "label": "Minutes label", "default": "MINS" },
    { "type": "text", "id": "seconds_label", "label": "Seconds label", "default": "SECS" },
    { "type": "text", "id": "expired_text", "label": "Text once it runs out", "info": "Replaces the clock. Leave empty to hold the clock at zero instead." },
    { "type": "header", "content": "Link" },
    { "type": "text", "id": "cta_label", "label": "Link label" },
    { "type": "text", "id": "cta_url", "label": "Link", "default": "#ces-bundle" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 0 }
  ],
  "presets": [{ "name": "CES Countdown bar" }]
}
{% endschema %}
