{{ 'ces-base.css' | asset_url | stylesheet_tag }}
{{ 'ces-theme.css' | asset_url | stylesheet_tag }}
{{ 'ces-accordion.css' | asset_url | stylesheet_tag }}
{{ 'ces-timeline-accordion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ces-accordion.js' | asset_url }}" defer="defer"></script>

{%- liquid
  if section.settings.exclusive
    assign accordion_group = 'ces-timeline-' | append: section.id
  endif
-%}

{% render 'ces-section-padding' %}

<div class="ces-section ces-timeline-accordion ces-section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="ces-section__inner ces-section__inner--narrow">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="ces-section__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="ces-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="ces-subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="ces-accordion ces-timeline-accordion__steps">
      {%- for block in section.blocks -%}
        {%- comment -%}
          The bullets are authored as one line per bullet in a textarea, which is
          far quicker to edit than a rich-text list, and turned into real list
          markup here.
        {%- endcomment -%}
        {%- capture step_content -%}
          {%- if block.settings.bullets != blank -%}
            <ul>
              {%- assign bullet_lines = block.settings.bullets | strip | newline_to_br | split: '<br />' -%}
              {%- for line in bullet_lines -%}
                {%- assign bullet = line | strip -%}
                {%- if bullet != blank -%}
                  <li>{{ bullet }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
          {{ block.settings.content }}
        {%- endcapture -%}

        {% render 'ces-accordion-item',
          id: block.id,
          variant: 'numbered',
          number: forloop.index,
          meta: block.settings.time_label,
          heading: block.settings.heading,
          content: step_content,
          open: block.settings.open,
          group: accordion_group,
          shopify_attributes: block.shopify_attributes
        %}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CES Timeline accordion",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "A numbered what-to-expect timeline. Steps are numbered automatically from their order, so reordering blocks renumbers them."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What to expect, week by week"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Astaxanthin builds up in your tissue, so the changes arrive in stages.*"
    },
    {
      "type": "checkbox",
      "id": "exclusive",
      "label": "Only one step open at a time",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "timeline_step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "time_label",
          "label": "Time label",
          "default": "Weeks 1-2"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Loading phase"
        },
        {
          "type": "textarea",
          "id": "bullets",
          "label": "Bullets",
          "info": "One bullet per line.",
          "default": "Astaxanthin begins saturating cell membranes\nAntioxidant reserves start to rebuild\nMost people feel no obvious change yet — this is normal"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Extra text",
          "info": "Shown below the bullets. Optional."
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "CES Timeline accordion",
      "blocks": [
        {
          "type": "timeline_step",
          "settings": {
            "time_label": "Weeks 1-2",
            "heading": "Loading phase",
            "open": true,
            "bullets": "Astaxanthin begins saturating cell membranes\nAntioxidant reserves start to rebuild\nMost people feel no obvious change yet — this is normal"
          }
        },
        {
          "type": "timeline_step",
          "settings": {
            "time_label": "Weeks 3-4",
            "heading": "First signs",
            "bullets": "Skin starts holding moisture better*\nLess afternoon flatness*\nEasier recovery the day after training*"
          }
        },
        {
          "type": "timeline_step",
          "settings": {
            "time_label": "Weeks 5-8",
            "heading": "Building momentum",
            "bullets": "Visible improvement in skin tone and elasticity*\nEyes feel less tired after long screen days*\nSteadier energy across the whole day*"
          }
        },
        {
          "type": "timeline_step",
          "settings": {
            "time_label": "Week 8+",
            "heading": "Full effect",
            "bullets": "Antioxidant support at its peak*\nJoint comfort and mobility hold up under load*\nThe results compound the longer you stay consistent*"
          }
        }
      ]
    }
  ]
}
{% endschema %}
