{{ 'ces-base.css' | asset_url | stylesheet_tag }}
{{ 'ces-theme.css' | asset_url | stylesheet_tag }}
{{ 'ces-feature-image-cards.css' | asset_url | stylesheet_tag }}

{% render 'ces-section-padding' %}

<div class="ces-section ces-feature-image-cards ces-section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="ces-section__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="ces-section__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="ces-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="ces-subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div
        class="ces-feature-image-cards__grid"
        style="--ces-feature-cards-count: {{ section.blocks.size }};"
      >
        {%- for block in section.blocks -%}
          <div class="ces-feature-image-cards__card" {{ block.shopify_attributes }}>
            <div class="ces-feature-image-cards__media" style="--ces-card-ratio: {{ section.settings.image_ratio }};">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    width: block.settings.image.width,
                    height: block.settings.image.height,
                    widths: '300, 450, 600, 900, 1200',
                    sizes: '(min-width: 990px) calc(var(--page-width) / 3), (min-width: 750px) 45vw, calc(100vw - 3rem)',
                    class: 'ces-feature-image-cards__image',
                    alt: block.settings.image.alt | escape
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'ces-placeholder-svg' }}
              {%- endif -%}
            </div>

            <div class="ces-feature-image-cards__body">
              {%- if block.settings.heading != blank -%}
                <h3 class="ces-feature-image-cards__heading">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="ces-feature-image-cards__text rte ces-rte">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "CES Feature image cards",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Comprehensive Wellness Benefits"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Three things we would not compromise on."
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 5", "label": "Portrait (4:5)" }
      ],
      "default": "1 / 1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "feature_card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Natural Astaxanthin"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Grown from Haematococcus pluvialis microalgae, never synthesised in a lab.</p>"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "CES Feature image cards",
      "blocks": [
        {
          "type": "feature_card",
          "settings": {
            "heading": "Natural Astaxanthin",
            "text": "<p>Grown from Haematococcus pluvialis microalgae in closed freshwater systems — never synthesised from petrochemicals.</p>"
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "heading": "Enhanced Absorption",
            "text": "<p>Astaxanthin is fat soluble, so every softgel carries it in cold-pressed olive oil instead of dry powder.</p>"
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "heading": "Clean & Lab Tested Quality",
            "text": "<p>Made in a cGMP-certified USA facility and third-party tested for potency, heavy metals and microbials.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
