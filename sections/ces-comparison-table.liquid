{{ 'ces-base.css' | asset_url | stylesheet_tag }}
{{ 'ces-theme.css' | asset_url | stylesheet_tag }}
{{ 'ces-comparison-table.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign brand_points = section.blocks | where: 'type', 'rovina_point'
  assign other_points = section.blocks | where: 'type', 'other_brand_point'
-%}

{% render 'ces-section-padding' %}

<div class="ces-section ces-comparison-table ces-section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="ces-section__inner ces-section__inner--narrow">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="ces-section__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="ces-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="ces-subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="ces-comparison-table__grid">
      <div class="ces-comparison-table__column ces-comparison-table__column--brand">
        <div class="ces-comparison-table__head">
          <div class="ces-comparison-table__thumb">
            {%- if section.settings.image != blank -%}
              {{
                section.settings.image
                | image_url: width: 400
                | image_tag:
                  loading: 'lazy',
                  width: 200,
                  height: 200,
                  widths: '100, 150, 200, 300, 400',
                  sizes: '8rem',
                  alt: section.settings.image.alt | escape
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'ces-placeholder-svg' }}
            {%- endif -%}
          </div>
          <p class="ces-comparison-table__label">{{ section.settings.brand_label }}</p>
        </div>

        {%- if brand_points.size > 0 -%}
          <ul class="ces-checklist ces-comparison-table__list" role="list">
            {%- for block in brand_points -%}
              {% render 'ces-checklist-item',
                text: block.settings.text,
                variant: 'check',
                icon_size: '1.8rem',
                shopify_attributes: block.shopify_attributes
              %}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="ces-comparison-table__column ces-comparison-table__column--other">
        <div class="ces-comparison-table__head">
          <p class="ces-comparison-table__label">{{ section.settings.other_label }}</p>
        </div>

        {%- if other_points.size > 0 -%}
          <ul class="ces-checklist ces-comparison-table__list" role="list">
            {%- for block in other_points -%}
              {% render 'ces-checklist-item',
                text: block.settings.text,
                variant: 'cross',
                icon_size: '1.8rem',
                shopify_attributes: block.shopify_attributes
              %}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.footnote != blank -%}
      <div class="ces-disclaimer rte ces-rte">{{ section.settings.footnote }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "CES Comparison table",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Two columns of claims. 'Your brand point' blocks get a green tick in the left column; 'Other brands point' blocks get a red cross in the right one. The two lists are independent, so they do not need to be the same length."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What sets Rovina apart"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product image",
      "info": "Shown at the top of your own column."
    },
    {
      "type": "text",
      "id": "brand_label",
      "label": "Your column label",
      "default": "Rovina"
    },
    {
      "type": "text",
      "id": "other_label",
      "label": "Other column label",
      "default": "Other Brands"
    },
    {
      "type": "richtext",
      "id": "footnote",
      "label": "Footnote"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "rovina_point",
      "name": "Your brand point",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "12mg natural astaxanthin per softgel"
        }
      ]
    },
    {
      "type": "other_brand_point",
      "name": "Other brands point",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "Under-dosed at 4mg or less"
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "CES Comparison table",
      "blocks": [
        { "type": "rovina_point", "settings": { "text": "12mg natural astaxanthin per softgel" } },
        { "type": "rovina_point", "settings": { "text": "Sourced from microalgae, never synthetic" } },
        { "type": "rovina_point", "settings": { "text": "Carried in cold-pressed oil for absorption" } },
        { "type": "rovina_point", "settings": { "text": "Third-party tested, every batch" } },
        { "type": "rovina_point", "settings": { "text": "90-day money back guarantee" } },
        { "type": "other_brand_point", "settings": { "text": "Under-dosed at 4mg or less" } },
        { "type": "other_brand_point", "settings": { "text": "Synthetic astaxanthin from petrochemicals" } },
        { "type": "other_brand_point", "settings": { "text": "Dry powder that absorbs poorly" } },
        { "type": "other_brand_point", "settings": { "text": "Tested in-house, if at all" } },
        { "type": "other_brand_point", "settings": { "text": "14-day returns on unopened bottles only" } }
      ]
    }
  ]
}
{% endschema %}
