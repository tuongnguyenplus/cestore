{{ 'ces-base.css' | asset_url | stylesheet_tag }}
{{ 'ces-theme.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .ces-whofor{color:rgb(var(--color-foreground));background:var(--gradient-background)}
  .ces-whofor__cols{display:grid;grid-template-columns:1fr;gap:1.6rem;margin-top:2.8rem}
  .ces-whofor__card{border:.1rem solid var(--ces-border-color);border-radius:var(--ces-radius);padding:2.4rem;background:var(--ces-surface)}
  .ces-whofor__card--yes{border-color:var(--ces-accent)}
  .ces-whofor__label{font-size:1.2rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;margin:0 0 1.4rem;color:var(--ces-accent)}
  .ces-whofor__card--no .ces-whofor__label{color:var(--ces-muted)}
  .ces-whofor__list{margin:0;padding:0;list-style:none}
  .ces-whofor__list li{position:relative;padding-left:2.8rem;margin:0 0 1.1rem;font-size:1.55rem;line-height:1.5}
  .ces-whofor__list li:last-child{margin-bottom:0}
  .ces-whofor__list li::before{position:absolute;left:0;top:0;font-weight:800}
  .ces-whofor__card--yes .ces-whofor__list li::before{content:"\2713";color:var(--ces-accent)}
  .ces-whofor__card--no .ces-whofor__list li::before{content:"\00d7";color:var(--ces-muted);font-size:1.8rem;line-height:1.3}
  .ces-whofor__honest{margin:2rem 0 0;font-size:1.5rem;line-height:1.55;font-style:italic;color:var(--ces-muted)}
  @media screen and (min-width:750px){.ces-whofor__cols{grid-template-columns:1fr 1fr}}
{%- endstyle -%}

{% render 'ces-section-padding' %}

<div class="ces-section ces-whofor ces-section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="ces-section__inner ces-section__inner--narrow">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="ces-section__header">
        {%- if section.settings.heading != blank -%}<h2 class="ces-heading">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="ces-subheading">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="ces-whofor__cols">
      <div class="ces-whofor__card ces-whofor__card--yes">
        <p class="ces-whofor__label">{{ section.settings.yes_label }}</p>
        <ul class="ces-whofor__list">
          {%- assign yes = section.settings.yes_points | newline_to_br | split: '<br />' -%}
          {%- for line in yes -%}{%- assign l = line | strip -%}{%- if l != blank -%}<li>{{ l }}</li>{%- endif -%}{%- endfor -%}
        </ul>
      </div>
      <div class="ces-whofor__card ces-whofor__card--no">
        <p class="ces-whofor__label">{{ section.settings.no_label }}</p>
        <ul class="ces-whofor__list">
          {%- assign no = section.settings.no_points | newline_to_br | split: '<br />' -%}
          {%- for line in no -%}{%- assign l = line | strip -%}{%- if l != blank -%}<li>{{ l }}</li>{%- endif -%}{%- endfor -%}
        </ul>
      </div>
    </div>

    {%- if section.settings.honest_line != blank -%}<p class="ces-whofor__honest">{{ section.settings.honest_line }}</p>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "CES Who It's For",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Who it's for — and the one thing it can't change" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "yes_label", "label": "Left column label", "default": "What CEBEAM works on" },
    { "type": "textarea", "id": "yes_points", "label": "Left column points (one per line)", "default": "Fluid and morning puffiness\nDark shadows and dullness\nThin, crepey skin and fine lines\nLost firmness in the under-eye" },
    { "type": "text", "id": "no_label", "label": "Right column label", "default": "What no patch can change" },
    { "type": "textarea", "id": "no_points", "label": "Right column points (one per line)", "default": "Inherited fat pads that push forward — the kind visible in photos of you at 25\nDeep hollows set by bone structure" },
    { "type": "textarea", "id": "honest_line", "label": "Honest closing line", "default": "Those are a surgical issue no topical can move. If that's mostly you, keep your money — we'd rather lose the sale than be the fifth thing that let you down." },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 40 }
  ],
  "presets": [ { "name": "CES Who It's For" } ]
}
{% endschema %}
