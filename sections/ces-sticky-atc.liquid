{{ 'ces-base.css' | asset_url | stylesheet_tag }}
{{ 'ces-theme.css' | asset_url | stylesheet_tag }}
{{ 'ces-sticky-atc.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ces-sticky-atc.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign target = section.settings.target_id | default: 'ces-app-price-slot' | handleize
  assign thumb = section.settings.image | default: product.featured_image
-%}

{%- if product != blank -%}
  {%- comment -%}
    The button is a plain anchor to the buy box rather than a second add-to-cart.
    Pricing and bundle selection belong to an app on this page, so a duplicate
    cart control here would either bypass the shopper's choices or fight the app
    for ownership of them. Sending them back to the real control is both safer
    and, with a bundle selector, the only correct behaviour.
  {%- endcomment -%}
  <ces-sticky-atc
    class="ces-section ces-sticky-atc color-{{ section.settings.color_scheme }} gradient"
    data-target="{{ target }}"
    {% if section.settings.hide_on_desktop %}
      data-mobile-only
    {% endif %}
    hidden
  >
    <div class="ces-sticky-atc__inner">
      <div class="ces-sticky-atc__info">
        {%- if section.settings.show_image and thumb != blank -%}
          <div class="ces-sticky-atc__thumb">
            {{
              thumb
              | image_url: width: 160
              | image_tag:
                loading: 'lazy',
                width: 80,
                height: 80,
                widths: '48, 64, 80, 120, 160',
                sizes: '4.8rem',
                alt: ''
            }}
          </div>
        {%- endif -%}

        <div class="ces-sticky-atc__text">
          <p class="ces-sticky-atc__title">{{ section.settings.title | default: product.title }}</p>

          {%- if section.settings.rating_text != blank or section.settings.stars > 0 -%}
            <p class="ces-sticky-atc__rating">
              {%- if section.settings.stars > 0 -%}
                <span
                  class="ces-sticky-atc__stars"
                  role="img"
                  aria-label="{{ section.settings.stars }} out of 5 stars"
                >
                  {%- for i in (1..5) -%}
                    {%- if i <= section.settings.stars -%}
                      {% render 'ces-icon', icon: 'star', size: '1.2rem' %}
                    {%- endif -%}
                  {%- endfor -%}
                </span>
              {%- endif -%}
              {%- if section.settings.rating_text != blank -%}
                <span>{{ section.settings.rating_text }}</span>
              {%- endif -%}
            </p>
          {%- endif -%}
        </div>
      </div>

      <a class="ces-button ces-sticky-atc__button" href="#{{ target }}">
        {{ section.settings.button_label }}
      </a>
    </div>
  </ces-sticky-atc>
{%- endif -%}

{% schema %}
{
  "name": "CES Sticky add to cart",
  "tag": "section",
  "class": "ces-sticky-atc-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "A bar that appears at the bottom of the screen once the buy box scrolls out of view. Its button scrolls back to the buy box rather than adding to cart, so it never bypasses a bundle or subscription app."
    },
    {
      "type": "text",
      "id": "target_id",
      "label": "Scroll target element ID",
      "info": "Usually the CES App slot's ID from the product section.",
      "default": "ces-app-price-slot"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "ADD TO CART"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show product thumbnail",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Thumbnail override",
      "info": "Defaults to the product's featured image."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title override",
      "info": "Defaults to the product title."
    },
    {
      "type": "range",
      "id": "stars",
      "min": 0,
      "max": 5,
      "step": 1,
      "label": "Stars",
      "info": "Set to 0 to hide them.",
      "default": 4
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "Rated 4.4 Excellent | Over 100,000 Sold"
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Mobile only",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "CES Sticky add to cart"
    }
  ]
}
{% endschema %}
