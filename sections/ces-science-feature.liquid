{{ 'ces-base.css' | asset_url | stylesheet_tag }}
{{ 'ces-theme.css' | asset_url | stylesheet_tag }}
{{ 'ces-science-feature.css' | asset_url | stylesheet_tag }}

{% render 'ces-section-padding' %}

<div class="ces-section ces-science-feature ces-section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="ces-section__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.intro != blank -%}
      <header class="ces-science-feature__header ces-reveal">
        {%- if section.settings.eyebrow != blank -%}
          <span class="ces-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="ces-heading ces-science-feature__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <div class="ces-science-feature__intro rte">{{ section.settings.intro }}</div>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="ces-science-feature__items">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'feature' -%}
            {%- liquid
              assign has_chips = false
              for i in (1..4)
                assign lk = 'chip_' | append: i | append: '_label'
                if block.settings[lk] != blank
                  assign has_chips = true
                endif
              endfor
            -%}
            <article
              class="ces-science-feature__item ces-reveal{% if block.settings.reverse %} is-reversed{% endif %}"
              {{ block.shopify_attributes }}
            >
              <div class="ces-science-feature__media">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1400
                    | image_tag:
                      loading: 'lazy',
                      widths: '400, 600, 800, 1100, 1400',
                      sizes: '(min-width: 750px) 45vw, calc(100vw - 3rem)',
                      class: 'ces-science-feature__image',
                      alt: block.settings.image.alt | escape
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'ces-placeholder-svg ces-science-feature__image' }}
                {%- endif -%}
              </div>

              <div class="ces-science-feature__body">
                {%- if block.settings.label != blank -%}
                  <span class="ces-eyebrow ces-science-feature__label">{{ block.settings.label }}</span>
                {%- endif -%}
                {%- if block.settings.science_heading != blank -%}
                  <h3 class="ces-science-feature__sci-heading">{{ block.settings.science_heading }}</h3>
                {%- endif -%}
                {%- if block.settings.science_text != blank -%}
                  <div class="ces-science-feature__sci-text rte">{{ block.settings.science_text }}</div>
                {%- endif -%}

                {%- if has_chips -%}
                  <div class="ces-science-feature__chips">
                    {%- if block.settings.chips_heading != blank -%}
                      <p class="ces-science-feature__chips-title">{{ block.settings.chips_heading }}</p>
                    {%- endif -%}
                    <ul class="ces-science-feature__chip-list" role="list">
                      {%- for i in (1..4) -%}
                        {%- assign lk = 'chip_' | append: i | append: '_label' -%}
                        {%- assign ik = 'chip_' | append: i | append: '_icon' -%}
                        {%- if block.settings[lk] != blank -%}
                          <li class="ces-science-feature__chip">
                            <span class="ces-science-feature__chip-icon">
                              {%- if block.settings[ik] != blank -%}
                                {{ block.settings[ik] | image_url: width: 96 | image_tag: loading: 'lazy', widths: '48, 96', alt: '' }}
                              {%- else -%}
                                <svg viewBox="0 0 20 20" width="14" height="14" fill="none" aria-hidden="true"><path d="M4 10.5l3.5 3.5L16 5.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                              {%- endif -%}
                            </span>
                            <span class="ces-science-feature__chip-label">{{ block.settings[lk] }}</span>
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  </div>
                {%- endif -%}

                {%- if block.settings.nerds_content != blank -%}
                  {%- if block.settings.nerds_collapsible -%}
                    <details class="ces-science-feature__nerds ces-science-feature__nerds--toggle">
                      <summary class="ces-science-feature__nerds-summary">
                        <span>{{ block.settings.nerds_heading | default: 'For the Beauty-Nerds' }}</span>
                        <span class="ces-science-feature__nerds-sign" aria-hidden="true"></span>
                      </summary>
                      <div class="ces-science-feature__nerds-body rte">{{ block.settings.nerds_content }}</div>
                    </details>
                  {%- else -%}
                    <div class="ces-science-feature__nerds">
                      {%- if block.settings.nerds_heading != blank -%}
                        <p class="ces-science-feature__nerds-title">{{ block.settings.nerds_heading }}</p>
                      {%- endif -%}
                      <div class="ces-science-feature__nerds-body rte">{{ block.settings.nerds_content }}</div>
                    </div>
                  {%- endif -%}
                {%- endif -%}
              </div>
            </article>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CES Science Feature",
  "tag": "section",
  "class": "ces-section-wrapper",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Science" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Advanced Features" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Two proven mechanisms combined into one effortless patch.</p>" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 48 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Microneedle Technology" },
        { "type": "checkbox", "id": "reverse", "label": "Image on the right", "default": false },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "science_heading", "label": "Science heading", "default": "The Science" },
        { "type": "richtext", "id": "science_text", "label": "Science text", "default": "<p>Describe how this mechanism works and why it matters.</p>" },
        { "type": "header", "content": "Clinically shown to (chips)" },
        { "type": "text", "id": "chips_heading", "label": "Chips heading", "default": "Clinically shown to" },
        { "type": "text", "id": "chip_1_label", "label": "Chip 1" },
        { "type": "image_picker", "id": "chip_1_icon", "label": "Chip 1 icon" },
        { "type": "text", "id": "chip_2_label", "label": "Chip 2" },
        { "type": "image_picker", "id": "chip_2_icon", "label": "Chip 2 icon" },
        { "type": "text", "id": "chip_3_label", "label": "Chip 3" },
        { "type": "image_picker", "id": "chip_3_icon", "label": "Chip 3 icon" },
        { "type": "text", "id": "chip_4_label", "label": "Chip 4" },
        { "type": "image_picker", "id": "chip_4_icon", "label": "Chip 4 icon" },
        { "type": "header", "content": "For the Beauty-Nerds" },
        { "type": "checkbox", "id": "nerds_collapsible", "label": "Collapse into a toggle", "default": true },
        { "type": "text", "id": "nerds_heading", "label": "Heading", "default": "For the Beauty-Nerds" },
        { "type": "richtext", "id": "nerds_content", "label": "Deep-dive content", "default": "<p><strong>Mechanism:</strong> Add the technical detail here.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CES Science Feature",
      "blocks": [
        { "type": "feature" },
        { "type": "feature", "settings": { "reverse": true, "label": "Deep Active Delivery" } },
        { "type": "feature", "settings": { "label": "Collagen Rebuild" } },
        { "type": "feature", "settings": { "reverse": true, "label": "Targeted Eye Design" } }
      ]
    }
  ]
}
{% endschema %}
