{{ 'ces-base.css' | asset_url | stylesheet_tag }}
{{ 'ces-theme.css' | asset_url | stylesheet_tag }}
{{ 'ces-icon-feature-grid.css' | asset_url | stylesheet_tag }}

{%- assign ces_needs_symbols = false -%}
{%- for block in section.blocks -%}
  {%- if block.settings.icon_text != blank and block.settings.image == blank -%}
    {%- assign ces_needs_symbols = true -%}
  {%- endif -%}
{%- endfor -%}
{%- if ces_needs_symbols -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
  >
{%- endif -%}

{% render 'ces-section-padding' %}

<div
  class="ces-section ces-icon-feature-grid ces-section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient"
  style="
    --ces-icon-grid-columns-mobile: {{ section.settings.columns_mobile }};
    --ces-icon-grid-columns-desktop: {{ section.settings.columns_desktop }};
  "
>
  <div class="ces-section__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="ces-section__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="ces-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="ces-subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="ces-icon-feature-grid__grid" style="--ces-icon-frame: {{ section.settings.icon_size }}rem;">
        {%- for block in section.blocks -%}
          <div class="ces-icon-feature-grid__item" {{ block.shopify_attributes }}>
            <span class="ces-icon-feature-grid__icon ces-icon-feature-grid__icon--{{ section.settings.icon_frame }}">
              {%- comment -%}
                Three ways to supply the mark, most specific first: an uploaded
                image, a literal glyph (an emoji, or an icon-font ligature if the
                store already loads one), or one of the theme's own SVGs.
              {%- endcomment -%}
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 480
                  | image_tag:
                    loading: 'lazy',
                    width: 240,
                    height: 240,
                    widths: '80, 120, 180, 240, 360, 480',
                    sizes: '10rem',
                    class: 'ces-icon-feature-grid__icon-image',
                    alt: ''
                }}
              {%- elsif block.settings.icon_text != blank -%}
                <span class="ces-icon-feature-grid__icon-text" aria-hidden="true">
                  {{- block.settings.icon_text -}}
                </span>
              {%- elsif block.settings.icon != 'none' -%}
                {% render 'ces-icon', icon: block.settings.icon, size: '3.2rem' %}
              {%- endif -%}
            </span>

            {%- if block.settings.heading != blank -%}
              <h3 class="ces-icon-feature-grid__heading">{{ block.settings.heading }}</h3>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <p class="ces-icon-feature-grid__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "CES Icon feature grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One Formula. Total Support."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "icon_frame",
      "label": "Icon frame",
      "info": "Turn the disc off for product shots on a transparent background.",
      "options": [
        {
          "value": "disc",
          "label": "Tinted disc"
        },
        {
          "value": "bare",
          "label": "None"
        }
      ],
      "default": "disc"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 4,
      "max": 16,
      "step": 0.4,
      "unit": "rem",
      "label": "Icon size",
      "default": 6.4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Columns on mobile",
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "icon_item",
      "name": "Item",
      "settings": [
        {
          "type": "paragraph",
          "content": "Pick one way to show the mark. An image wins over a glyph, and a glyph wins over the built-in icon."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "icon_text",
          "label": "Icon glyph",
          "info": "An emoji, or an icon-font ligature such as blood_pressure if your store already loads that font."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Built-in icon",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "lightning",
              "label": "Lightning bolt"
            },
            {
              "value": "sparkle",
              "label": "Sparkle"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "plant",
              "label": "Plant"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "stopwatch",
              "label": "Stopwatch"
            },
            {
              "value": "fire",
              "label": "Flame"
            },
            {
              "value": "check-circle",
              "label": "Check in a circle"
            },
            {
              "value": "lock",
              "label": "Padlock"
            }
          ],
          "default": "heart"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heart health"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "info": "Optional supporting line."
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "CES Icon feature grid",
      "blocks": [
        {
          "type": "icon_item",
          "settings": {
            "icon": "heart",
            "heading": "Heart health*"
          }
        },
        {
          "type": "icon_item",
          "settings": {
            "icon": "sparkle",
            "heading": "Skin radiance*"
          }
        },
        {
          "type": "icon_item",
          "settings": {
            "icon": "lightning",
            "heading": "Daily energy*"
          }
        },
        {
          "type": "icon_item",
          "settings": {
            "icon": "stopwatch",
            "heading": "Faster recovery*"
          }
        }
      ]
    }
  ]
}
{% endschema %}
