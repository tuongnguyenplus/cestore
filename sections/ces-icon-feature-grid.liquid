{{ 'ces-base.css' | asset_url | stylesheet_tag }}
{{ 'ces-theme.css' | asset_url | stylesheet_tag }}
{{ 'ces-icon-feature-grid.css' | asset_url | stylesheet_tag }}

{%- assign ces_needs_symbols = false -%}
{%- for block in section.blocks -%}
  {%- if block.settings.icon_text != blank and block.settings.image == blank -%}
    {%- assign ces_needs_symbols = true -%}
  {%- endif -%}
{%- endfor -%}
{%- if ces_needs_symbols -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
  >
{%- endif -%}

{%- style -%}
  .ces-icon-feature-grid__eyebrow{margin:0 0 .8rem;font-size:1.7rem;font-weight:700;line-height:1.3;color:var(--ces-accent)}
  /* As a verdict rather than a description: an outlined chip that reads as a
     label stamped on the thing above it. */
  .ces-icon-feature-grid__pill{display:inline-block;margin:1rem 0 0;padding:.6rem 1.4rem;
    border:.15rem solid var(--ces-pill-color,var(--ces-danger));border-radius:var(--ces-radius-pill);
    color:var(--ces-pill-color,var(--ces-danger));font-size:1.4rem;font-weight:700;line-height:1.25}
  @media screen and (min-width:750px){
    .ces-icon-feature-grid__eyebrow{font-size:2rem}
    .ces-icon-feature-grid__pill{font-size:1.5rem}
  }
{%- endstyle -%}

{% render 'ces-section-padding' %}

<div
  class="ces-section ces-icon-feature-grid ces-section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient"
  style="
    --ces-icon-grid-columns-mobile: {{ section.settings.columns_mobile }};
    --ces-icon-grid-columns-desktop: {{ section.settings.columns_desktop }};
    {% if section.settings.icon_color != blank %}--ces-icon-color: {{ section.settings.icon_color }};{% endif %}
    {% if section.settings.pill_color != blank %}--ces-pill-color: {{ section.settings.pill_color }};{% endif %}
  "
>
  <div class="ces-section__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="ces-section__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ces-icon-feature-grid__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          {%- liquid
            assign ces_heading = section.settings.heading
            if section.settings.highlight_words != blank
              assign ces_words = section.settings.highlight_words | split: ','
              for ces_word in ces_words
                assign ces_word = ces_word | strip
                if ces_word == blank
                  continue
                endif
                capture ces_hl
                  echo '<span class="ces-icon-feature-grid__heading-accent">'
                  echo ces_word
                  echo '</span>'
                endcapture
                assign ces_heading = ces_heading | replace: ces_word, ces_hl
              endfor
            endif
          -%}
          <h2 class="ces-heading">{{ ces_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="ces-subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="ces-icon-feature-grid__grid" style="--ces-icon-frame: {{ section.settings.icon_size }}rem;--ces-icon-image-scale: {{ section.settings.image_scale | default: 50 }}%;">
        {%- for block in section.blocks -%}
          <div class="ces-icon-feature-grid__item" {{ block.shopify_attributes }}>
            <span
              class="ces-icon-feature-grid__icon ces-icon-feature-grid__icon--{{ section.settings.icon_frame }}"
              {% if block.settings.icon_color != blank %}style="--ces-icon-color: {{ block.settings.icon_color }};"{% endif %}
            >
              {%- comment -%}
                Three ways to supply the mark, most specific first: an uploaded
                image, a literal glyph (an emoji, or an icon-font ligature if the
                store already loads one), or one of the theme's own SVGs.
              {%- endcomment -%}
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 480
                  | image_tag:
                    loading: 'lazy',
                    width: 240,
                    height: 240,
                    widths: '80, 120, 180, 240, 360, 480',
                    sizes: '10rem',
                    class: 'ces-icon-feature-grid__icon-image',
                    alt: ''
                }}
              {%- elsif block.settings.icon_text != blank -%}
                <span class="ces-icon-feature-grid__icon-text" aria-hidden="true">
                  {{- block.settings.icon_text -}}
                </span>
              {%- elsif block.settings.icon != 'none' -%}
                {% render 'ces-icon', icon: block.settings.icon, size: '3.2rem' %}
              {%- endif -%}
            </span>

            {%- if block.settings.heading != blank -%}
              <h3 class="ces-icon-feature-grid__heading">{{ block.settings.heading }}</h3>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              {%- if section.settings.text_style == 'pill' -%}
                <p class="ces-icon-feature-grid__pill">{{ block.settings.text }}</p>
              {%- else -%}
                <p class="ces-icon-feature-grid__text">{{ block.settings.text }}</p>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {% render 'ces-cta-rail',
       label: section.settings.cta_label,
       url: section.settings.cta_url,
       footnote: section.settings.cta_footnote,
       width: section.settings.cta_width,
       arrow: section.settings.cta_arrow,
       id: section.id %}
  </div>
</div>

{% schema %}
{
  "name": "CES Icon feature grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "select",
      "id": "text_style",
      "label": "How the text under each heading looks",
      "options": [
        { "value": "text", "label": "A line of description" },
        { "value": "pill", "label": "An outlined chip, as a verdict" }
      ],
      "default": "text"
    },
    {
      "type": "color",
      "id": "pill_color",
      "label": "Chip colour",
      "default": "#c0392b"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One Formula. Total Support."
    },
    {
      "type": "text",
      "id": "highlight_words",
      "label": "Highlighted words",
      "info": "Comma-separated words or phrases inside the heading to show in the icon color, e.g. Rovina, Antioxidant, Cellular."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "info": "Used for the built-in icons and the highlighted heading words.",
      "default": "#1d5c5c"
    },
    {
      "type": "select",
      "id": "icon_frame",
      "label": "Icon frame",
      "info": "Turn the disc off for product shots on a transparent background.",
      "options": [
        {
          "value": "disc",
          "label": "Tinted disc"
        },
        {
          "value": "bare",
          "label": "None"
        }
      ],
      "default": "disc"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 4,
      "max": 16,
      "step": 1,
      "unit": "rem",
      "label": "Icon size",
      "default": 6
    },
    {
      "type": "range",
      "id": "image_scale",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "How much of the disc the picture fills",
      "info": "Only applies when the icon frame is a tinted disc.",
      "default": 60
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Columns on mobile",
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link",
      "info": "Defaults to the product buy box (#ces-bundle)."
    },
    {
      "type": "text",
      "id": "cta_footnote",
      "label": "Text under the button"
    },

    {
      "type": "checkbox",
      "id": "cta_arrow",
      "label": "Arrow after the label",
      "default": false
    },
    {
      "type": "select",
      "id": "cta_width",
      "label": "Button width",
      "options": [
        { "value": "auto", "label": "As wide as its label" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "auto"
    },    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "icon_item",
      "name": "Item",
      "settings": [
        {
          "type": "paragraph",
          "content": "Pick one way to show the mark. An image wins over a glyph, and a glyph wins over the built-in icon."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "icon_text",
          "label": "Icon glyph",
          "info": "An emoji, or an icon-font ligature such as blood_pressure if your store already loads that font."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Built-in icon",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "lightning",
              "label": "Lightning bolt"
            },
            {
              "value": "sparkle",
              "label": "Sparkle"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "plant",
              "label": "Plant"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "stopwatch",
              "label": "Stopwatch"
            },
            {
              "value": "fire",
              "label": "Flame"
            },
            {
              "value": "check-circle",
              "label": "Check in a circle"
            },
            {
              "value": "lock",
              "label": "Padlock"
            },
            {
              "value": "cell-defense",
              "label": "Cell (antioxidant defense)"
            },
            {
              "value": "molecule",
              "label": "Molecule (oxidative stress)"
            },
            {
              "value": "vitality",
              "label": "Vitality (energy)"
            },
            {
              "value": "inflammation",
              "label": "Inflammation"
            },
            {
              "value": "heart-plus",
              "label": "Heart plus (cardiovascular)"
            },
            {
              "value": "skin-aging",
              "label": "Skin & aging"
            },
            {
              "value": "eye",
              "label": "Eye / dark circles"
            },
            {
              "value": "depuff",
              "label": "De-puff / drain"
            },
            {
              "value": "smooth",
              "label": "Smooth / fine lines"
            },
            {
              "value": "firm",
              "label": "Firm / hydrate"
            }
          ],
          "default": "cell-defense"
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Icon color (this item)",
          "info": "Overrides the section icon color for this item. Leave blank to use the section color."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heart health"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "info": "Optional supporting line."
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "CES Icon feature grid",
      "blocks": [
        {
          "type": "icon_item",
          "settings": {
            "icon": "heart",
            "heading": "Heart health*"
          }
        },
        {
          "type": "icon_item",
          "settings": {
            "icon": "sparkle",
            "heading": "Skin radiance*"
          }
        },
        {
          "type": "icon_item",
          "settings": {
            "icon": "lightning",
            "heading": "Daily energy*"
          }
        },
        {
          "type": "icon_item",
          "settings": {
            "icon": "stopwatch",
            "heading": "Faster recovery*"
          }
        }
      ]
    }
  ]
}
{% endschema %}
