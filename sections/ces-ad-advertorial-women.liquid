<style>
.ces-adv{--teal:#1d5c5c;--teal-d:#164747;--ink:#1b2320;--muted:#5d6b67;--line:#e7e1d8;--paper:#fff;--sand:#f6f2ec;--mint:#eaf1ef;--gold:#d99b2b;
  --serif:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,"Times New Roman",serif;
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:17px;line-height:1.68}
.ces-adv *{box-sizing:border-box}
.ces-adv img{max-width:100%;display:block}
.ces-adv mark{background:transparent;color:inherit;padding:0}
.ces-adv .bar{background:var(--teal);color:#fff;text-align:center;font-size:12.5px;letter-spacing:.06em;padding:9px;font-weight:700;text-transform:uppercase}
.ces-adv .mast{border-bottom:1px solid var(--line);text-align:center;padding:14px 0}
.ces-adv .mast .brand{font-family:var(--serif);font-size:22px;letter-spacing:.42em;font-weight:600;padding-left:.42em}
.ces-adv .col{max-width:720px;margin:0 auto;padding:0 22px}
.ces-adv .article{padding:34px 0 8px}
.ces-adv .eyebrow{font-size:11.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--teal);font-weight:800;margin:0 0 12px}
.ces-adv h1{font-family:var(--serif);font-weight:600;font-size:clamp(28px,4.6vw,40px);line-height:1.16;margin:0 0 18px}
.ces-adv h1 em{font-style:italic;color:var(--teal)}
.ces-adv .byline{display:flex;align-items:center;gap:11px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:12px 0;margin:0 0 24px}
.ces-adv .byline .av{width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,#2e7d7d,#164747);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px}
.ces-adv .byline .who{font-size:13.5px}
.ces-adv .byline .who b{display:block}
.ces-adv .byline .who span{color:var(--muted);font-size:12px}
.ces-adv .article p{margin:0 0 18px}
.ces-adv .callout{background:var(--sand);border-left:4px solid var(--teal);border-radius:0 12px 12px 0;padding:18px 20px;margin:22px 0;font-family:var(--serif);font-size:19px;font-style:italic;color:#26332f}
.ces-adv .sec-h{font-family:var(--serif);font-weight:600;font-size:clamp(24px,3.6vw,31px);text-align:center;margin:6px 0 4px}
.ces-adv .sec-h em{font-style:italic;color:var(--teal)}
.ces-adv .feature-wrap{background:var(--mint);padding:44px 0}
.ces-adv .feat{display:grid;grid-template-columns:150px 1fr;gap:20px;align-items:center;background:#fff;border:1px solid #dbe6e2;border-radius:16px;padding:16px;margin:16px 0;box-shadow:0 10px 26px rgba(22,71,71,.07)}
.ces-adv .feat .ic{width:150px;height:120px;border-radius:12px;overflow:hidden;background:linear-gradient(160deg,#dfe8e5,#cdddd8);display:flex;align-items:center;justify-content:center;color:#5f716d;font-size:12px;text-align:center;padding:10px}
.ces-adv .feat .ic img{width:100%;height:100%;object-fit:cover}
.ces-adv .feat h3{font-family:var(--serif);font-size:20px;font-weight:600;margin:0 0 7px}
.ces-adv .feat p{margin:0;font-size:15px;color:#33403c}
.ces-adv .feat .stars{color:var(--gold);font-size:14px;margin-top:8px}
.ces-adv .feat.alt{grid-template-columns:1fr 150px}
.ces-adv .feat.alt .ic{order:2}
.ces-adv .cta-c{text-align:center;padding:30px 22px 0}
.ces-adv .btn{display:inline-block;background:var(--teal);color:#fff;text-decoration:none;font-weight:700;letter-spacing:.04em;padding:16px 36px;border-radius:999px;font-size:15px;box-shadow:0 10px 24px rgba(29,92,92,.24)}
.ces-adv .story{padding:36px 0 6px}
.ces-adv .story .sec-h{text-align:left}
.ces-adv .story p{margin:0 0 18px}
.ces-adv .pull{border-left:3px solid var(--teal);background:var(--sand);padding:12px 16px;border-radius:0 10px 10px 0;font-family:var(--serif);font-style:italic;font-size:18px;color:#243330;margin:18px 0}
.ces-adv .guarantee{max-width:720px;margin:26px auto;padding:0 22px}
.ces-adv .g-card{border:2px solid var(--teal);border-radius:18px;padding:26px;text-align:center;background:#fff}
.ces-adv .badge{width:76px;height:76px;border-radius:50%;background:var(--teal);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;margin:-52px auto 12px;font-weight:800;line-height:1.05;box-shadow:0 8px 18px rgba(22,71,71,.28)}
.ces-adv .badge b{font-size:22px}.ces-adv .badge span{font-size:9px;letter-spacing:.08em}
.ces-adv .g-card h3{font-family:var(--serif);font-size:23px;font-weight:600;margin:0 0 8px}
.ces-adv .g-card p{margin:0;color:#33403c;font-size:15px}
.ces-adv .offer{background:var(--teal);color:#fff;text-align:center;padding:52px 22px;margin-top:26px}
.ces-adv .offer h2{font-family:var(--serif);color:#fff;font-size:clamp(26px,4vw,36px);font-weight:600;margin:0 0 8px}
.ces-adv .offer .sub{color:#cfe3df;max-width:540px;margin:0 auto 20px}
.ces-adv .offer .btn{background:#fff;color:var(--teal)}
.ces-adv .offer .rate2{margin-top:16px;color:#cfe3df;font-size:13px}.ces-adv .offer .rate2 .stars{color:#ffd479}
.ces-adv .reviews{padding:50px 22px;background:var(--sand)}
.ces-adv .reviews h3{font-family:var(--serif);text-align:center;font-size:27px;font-weight:600;margin:0 0 24px}
.ces-adv .rev-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;max-width:1000px;margin:0 auto}
.ces-adv .rev{background:#fff;border:1px solid var(--line);border-radius:14px;padding:20px}
.ces-adv .rev .stars{color:var(--gold);font-size:14px}.ces-adv .rev p{font-size:14.5px;color:#33403c;margin:10px 0 14px}
.ces-adv .rev .who{font-size:13px;font-weight:700}.ces-adv .rev .vf{font-size:11.5px;color:var(--teal);font-weight:700}
.ces-adv .legal{background:#fff;text-align:center;color:var(--muted);font-size:11.5px;padding:20px 22px 0}
@media(max-width:760px){.ces-adv .feat,.ces-adv .feat.alt{grid-template-columns:1fr}.ces-adv .feat .ic,.ces-adv .feat.alt .ic{order:0;width:100%;height:150px}.ces-adv .rev-grid{grid-template-columns:1fr}}
</style>

<div class="ces-ad ces-adv ces-ad--advertorial-women">
<div class="bar">Limited time · up to {{ section.settings.discount_pct }}% off + free shipping</div>
<header class="mast"><span class="brand">{{ section.settings.brand_name }}</span></header>

<article class="article"><div class="col">
  <p class="eyebrow">{{ section.settings.eyebrow }}</p>
  <h1>{{ section.settings.hero_heading }}</h1>
  <div class="byline"><div class="av">{{ section.settings.byline_initials }}</div><div class="who"><b>{{ section.settings.byline_name }}</b><span>{{ section.settings.byline_sub }}</span></div></div>
  {{ section.settings.intro }}
  <div class="callout">{{ section.settings.callout }}</div>
</div></article>

<section class="feature-wrap">
  <div class="col"><h2 class="sec-h">{{ section.settings.features_heading }}</h2></div>
  <div class="col">
    <div class="feat"><div class="ic">{% if section.settings.feat1_image != blank %}{{ section.settings.feat1_image | image_tag: loading: 'lazy', widths: '375,550,750,1100,1400,1600', sizes: '(min-width:760px) 50vw, 100vw', alt: 'CEBEAM Microneedle Patches' }}{% else %}Image 1{% endif %}</div><div><h3>{{ section.settings.feat1_heading }}</h3><p>{{ section.settings.feat1_text }}</p></div></div>
    <div class="feat alt"><div><h3>{{ section.settings.feat2_heading }}</h3><p>{{ section.settings.feat2_text }}</p></div><div class="ic">{% if section.settings.feat2_image != blank %}{{ section.settings.feat2_image | image_tag: loading: 'lazy', widths: '375,550,750,1100,1400,1600', sizes: '(min-width:760px) 50vw, 100vw', alt: 'CEBEAM Microneedle Patches' }}{% else %}Image 2{% endif %}</div></div>
    <div class="feat"><div class="ic">{% if section.settings.feat3_image != blank %}{{ section.settings.feat3_image | image_tag: loading: 'lazy', widths: '375,550,750,1100,1400,1600', sizes: '(min-width:760px) 50vw, 100vw', alt: 'CEBEAM Microneedle Patches' }}{% else %}Image 3{% endif %}</div><div><h3>{{ section.settings.feat3_heading }}</h3><p>{{ section.settings.feat3_text }}</p></div></div>
    <div class="feat alt"><div><h3>{{ section.settings.feat4_heading }}</h3><p>{{ section.settings.feat4_text }}</p>{% if section.settings.feat4_stars != blank %}<div class="stars">★★★★★ &nbsp;{{ section.settings.feat4_stars }}</div>{% endif %}</div><div class="ic">{% if section.settings.feat4_image != blank %}{{ section.settings.feat4_image | image_tag: loading: 'lazy', widths: '375,550,750,1100,1400,1600', sizes: '(min-width:760px) 50vw, 100vw', alt: 'CEBEAM Microneedle Patches' }}{% else %}Image 4{% endif %}</div></div>
  </div>
  <div class="cta-c"><a class="btn" href="#ces-offer">{{ section.settings.features_cta_label }}</a></div>
</section>

<section class="story"><div class="col">
  <h2 class="sec-h">{{ section.settings.story_heading }}</h2>
  {{ section.settings.story_body }}
  <div class="pull">{{ section.settings.story_quote }}</div>
</div></section>

<div class="guarantee"><div class="g-card">
  <div class="badge"><b>{{ section.settings.guarantee_days }}</b><span>DAY</span></div>
  <h3>{{ section.settings.guarantee_heading }}</h3>
  <p>{{ section.settings.guarantee_text }}</p>
</div></div>

<section class="offer" id="ces-offer">
  <h2>{{ section.settings.offer_heading }}</h2>
  <p class="sub">{{ section.settings.offer_sub }}</p>
  <a class="btn" href="{{ section.settings.cta_url | default: '/products/rovina' }}">{{ section.settings.offer_cta_label }}</a>
  <div class="rate2"><span class="stars">★★★★★</span> &nbsp;Rated {{ section.settings.rating_value }}/5 by {{ section.settings.rating_count }} customers</div>
</section>

<section class="reviews">
  <h3>{{ section.settings.reviews_heading }}</h3>
  <div class="rev-grid"><div class="rev"><div class="stars">★★★★★</div><p>{{ section.settings.r1_quote }}</p><div class="who">{{ section.settings.r1_name }}</div><div class="vf">✓ Verified buyer</div></div><div class="rev"><div class="stars">★★★★★</div><p>{{ section.settings.r2_quote }}</p><div class="who">{{ section.settings.r2_name }}</div><div class="vf">✓ Verified buyer</div></div><div class="rev"><div class="stars">★★★★★</div><p>{{ section.settings.r3_quote }}</p><div class="who">{{ section.settings.r3_name }}</div><div class="vf">✓ Verified buyer</div></div></div>
</section>

{%- if section.settings.legal_company != blank -%}<div class="legal">{{ section.settings.legal_company }}</div>{%- endif -%}
{% render 'ces-ad-disclaimer', show: section.settings.show_disclaimer, text: section.settings.disclaimer_text, copyright: section.settings.copyright_text %}
</div>
