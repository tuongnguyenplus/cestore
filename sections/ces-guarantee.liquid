<script src="{{ 'ces-scroll.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign gt_cards = section.blocks | where: 'type', 'promise'
-%}

{%- style -%}
  .ces-gt{color:rgb(var(--color-foreground));background:var(--gradient-background)}
  /* The seal and the promise read as one statement, so they sit together
     rather than the badge floating above a centred heading. */
  .ces-gt__head{display:flex;flex-direction:column;align-items:center;gap:1.6rem;text-align:center}
  .ces-gt__seal{flex:0 0 auto;width:14rem;max-width:40%}
  .ces-gt__seal img{display:block;width:100%;height:auto}
  .ces-gt__accent{color:var(--ces-accent)}
  .ces-gt__sub{margin:1rem 0 0;font-size:1.6rem;line-height:1.55;color:var(--ces-muted)}
  .ces-gt__grid{display:grid;grid-template-columns:1fr;gap:1.6rem;margin-top:3.2rem}
  .ces-gt__card{padding:2rem;border-radius:1.6rem;border:.1rem solid var(--ces-border-color);
    background:var(--ces-card-bg,var(--ces-surface))}
  .ces-gt__icon{display:inline-flex;align-items:center;justify-content:center;
    width:4.4rem;height:4.4rem;margin-bottom:1.6rem;border-radius:1.2rem;
    background:var(--ces-accent);color:rgb(var(--color-background))}
  .ces-gt__icon .ces-icon{width:2.2rem;height:2.2rem}
  .ces-gt__card-title{margin:0 0 .8rem;font-size:1.75rem;font-weight:700;line-height:1.35}
  .ces-gt__card-text{margin:0;font-size:1.5rem;line-height:1.55;color:var(--ces-muted)}
  /* An aside answering the obvious question, marked by a rule down its edge
     rather than boxed again. */
  .ces-gt__why{margin:2.4rem 0 0;padding:2rem 2.2rem;border-radius:1.2rem;
    border-left:.4rem solid var(--ces-accent);background:var(--ces-why-bg,var(--ces-surface))}
  .ces-gt__why-title{margin:0 0 .8rem;font-size:1.7rem;font-weight:700;line-height:1.3;
    color:var(--ces-accent)}
  .ces-gt__why-text{margin:0;font-size:1.6rem;line-height:1.6}
  .ces-gt__why-text > :first-child{margin-top:0}
  .ces-gt__why-text > :last-child{margin-bottom:0}
  @media screen and (min-width:750px){
    .ces-gt__head{flex-direction:row;align-items:center;gap:3.2rem;text-align:left}
    .ces-gt__seal{width:18rem;max-width:none}
    .ces-gt__grid{grid-template-columns:repeat({{ gt_cards.size | at_least: 1 | at_most: 4 }},minmax(0,1fr));gap:2.4rem}
    .ces-gt__card{padding:2.4rem}
    .ces-gt__why{margin-top:3.2rem;padding:2.4rem 2.8rem}
  }
{%- endstyle -%}

{% render 'ces-section-padding' %}

<div
  class="ces-section ces-gt ces-section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient"
  style="{% if section.settings.card_bg != blank %}--ces-card-bg: {{ section.settings.card_bg }};{% endif %}{% if section.settings.why_bg != blank %}--ces-why-bg: {{ section.settings.why_bg }};{% endif %}"
>
  <div class="ces-section__inner">
    {%- if section.settings.seal != blank or section.settings.heading != blank -%}
      <div class="ces-gt__head">
        {%- if section.settings.seal != blank -%}
          <div class="ces-gt__seal">
            {%- assign g_seal_alt = section.settings.seal_alt | escape -%}
            {% render 'ces-img',
               image: section.settings.seal,
               alt: g_seal_alt,
               sizes: '(min-width: 750px) 160px, 120px',
               max: 420 %}
          </div>
        {%- endif -%}
        <div>
          {%- if section.settings.heading != blank -%}
            {%- liquid
              assign gt_heading = section.settings.heading
              assign gt_accent = section.settings.heading_accent | strip
              if gt_accent != blank and gt_heading contains gt_accent
                capture gt_wrapped
                  echo '<span class="ces-gt__accent">'
                  echo gt_accent
                  echo '</span>'
                endcapture
                assign gt_heading = gt_heading | replace: gt_accent, gt_wrapped
              endif
            -%}
            <h2 class="ces-heading">{{ gt_heading }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="ces-gt__sub">{{ section.settings.subheading }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if gt_cards.size > 0 -%}
      <div class="ces-gt__grid">
        {%- for block in gt_cards -%}
          <div class="ces-gt__card" {{ block.shopify_attributes }}>
            <span class="ces-gt__icon" aria-hidden="true">
              {% render 'ces-icon', icon: block.settings.icon %}
            </span>
            {%- if block.settings.title != blank -%}
              <h3 class="ces-gt__card-title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="ces-gt__card-text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.why_title != blank or section.settings.why_text != blank -%}
      <aside class="ces-gt__why">
        {%- if section.settings.why_title != blank -%}
          <p class="ces-gt__why-title">{{ section.settings.why_title }}</p>
        {%- endif -%}
        {%- if section.settings.why_text != blank -%}
          <div class="ces-gt__why-text ces-rte">{{ section.settings.why_text }}</div>
        {%- endif -%}
      </aside>
    {%- endif -%}

    {% render 'ces-cta-rail',
       label: section.settings.cta_label,
       url: section.settings.cta_url,
       footnote: section.settings.cta_footnote,
       width: section.settings.cta_width,
       arrow: section.settings.cta_arrow,
       id: section.id %}
  </div>
</div>

{% schema %}
{
  "name": "CES Guarantee",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "seal", "label": "Guarantee seal" },
    { "type": "text", "id": "seal_alt", "label": "Seal description", "default": "90 day money back guarantee" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Try CEBEAM Patches Completely Risk Free For 30 Days" },
    { "type": "text", "id": "heading_accent", "label": "Part of the heading to colour", "info": "Type the words exactly as they appear in the heading." },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "header", "content": "The promises" },
    { "type": "color", "id": "card_bg", "label": "Card background" },
    { "type": "header", "content": "Why we offer it" },
    { "type": "text", "id": "why_title", "label": "Question", "default": "Why do we offer this?" },
    { "type": "richtext", "id": "why_text", "label": "Answer" },
    { "type": "color", "id": "why_bg", "label": "Background" },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_label", "label": "Button label" },
    { "type": "url", "id": "cta_url", "label": "Button link", "info": "Defaults to the product buy box (#ces-bundle)." },
    { "type": "text", "id": "cta_footnote", "label": "Text under the button", "info": "One line each as \"icon | label\" renders them with icons side by side." },
    {
      "type": "select",
      "id": "cta_width",
      "label": "Button width",
      "options": [
        { "value": "auto", "label": "As wide as its label" },
        { "value": "full", "label": "One size, centred" }
      ],
      "default": "full"
    },
    { "type": "checkbox", "id": "cta_arrow", "label": "Arrow after the label", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 48 }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Mark",
          "options": [
            { "value": "stopwatch", "label": "Calendar or clock" },
            { "value": "shield", "label": "Shield" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "check-circle", "label": "Check" },
            { "value": "return", "label": "Return" },
            { "value": "heart", "label": "Heart" }
          ],
          "default": "check-circle"
        },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "CES Guarantee",
      "blocks": [{ "type": "promise" }, { "type": "promise" }, { "type": "promise" }]
    }
  ]
}
{% endschema %}
