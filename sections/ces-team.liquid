{{ 'ces-base.css' | asset_url | stylesheet_tag }}
{{ 'ces-theme.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .ces-team{color:rgb(var(--color-foreground));background:var(--gradient-background)}
  .ces-team__grid{display:grid;grid-template-columns:1fr;gap:2.8rem;align-items:center}
  .ces-team__media{aspect-ratio:4/3;border-radius:var(--ces-radius);overflow:hidden;background:var(--ces-surface);border:.1rem solid var(--ces-border-color)}
  .ces-team__media img{width:100%;height:100%;object-fit:cover;display:block}
  .ces-team__ph{width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:var(--ces-muted);font-size:1.3rem;text-align:center;padding:2rem}
  .ces-team__body h2{margin-top:0}
  .ces-team__body .ces-rte{font-size:1.6rem;line-height:1.6}
  .ces-team__sign{margin-top:1.8rem;font-weight:700;font-size:1.5rem}
  .ces-team__role{color:var(--ces-muted);font-weight:500}
  @media screen and (min-width:750px){.ces-team__grid{grid-template-columns:5fr 6fr;gap:4rem}
    .ces-team--media-right .ces-team__media{order:2}}
{%- endstyle -%}

{% render 'ces-section-padding' %}

<div class="ces-section ces-team ces-team--media-{{ section.settings.image_position }} ces-section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="ces-section__inner">
    <div class="ces-team__grid">
      <div class="ces-team__media">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
        {%- else -%}
          <span class="ces-team__ph">Founder / team photo</span>
        {%- endif -%}
      </div>
      <div class="ces-team__body">
        {%- if section.settings.heading != blank -%}<h2 class="ces-heading">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.body != blank -%}<div class="rte ces-rte">{{ section.settings.body }}</div>{%- endif -%}
        {%- if section.settings.signature != blank -%}
          <p class="ces-team__sign">{{ section.settings.signature }}{%- if section.settings.role != blank -%}<span class="ces-team__role"> — {{ section.settings.role }}</span>{%- endif -%}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CES Team",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Founder / team photo" },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The people behind CEBEAM" },
    { "type": "richtext", "id": "body", "label": "Story", "default": "<p>We built CEBEAM because the eye-care aisle is full of creams that never get past the surface — and we were tired of paying for hope. So we started with the delivery problem first: dissolving micro-cones that carry real actives to where dark circles and puffiness actually form.</p><p>Every batch is made in a GMP-certified facility, dermatologist-tested, and backed by a 90-day money-back guarantee. If it doesn't work for you, you don't keep it a secret and we don't keep your money.</p>" },
    { "type": "text", "id": "signature", "label": "Signature name" },
    { "type": "text", "id": "role", "label": "Signature role", "default": "Founder, CEBEAM" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 40 }
  ],
  "presets": [ { "name": "CES Team" } ]
}
{% endschema %}
