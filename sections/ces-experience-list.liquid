{{ 'ces-base.css' | asset_url | stylesheet_tag }}
{{ 'ces-theme.css' | asset_url | stylesheet_tag }}
{{ 'ces-experience-list.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .ces-experience-list__accent{color:var(--ces-accent)}
  /* The photograph closes the list rather than illustrating any one line of
     it, so it sits full width under the whole set. */
  .ces-experience-list__figure{margin:2.4rem 0 0}
  .ces-experience-list__figure img{display:block;width:100%;height:auto;border-radius:var(--ces-radius)}
  .ces-experience-list__caption{margin:.8rem 0 0;font-size:1.3rem;line-height:1.45;text-align:center;color:var(--ces-muted)}
  @media screen and (min-width:750px){
    .ces-experience-list__figure{margin-top:3.2rem}
  }
{%- endstyle -%}

{% render 'ces-section-padding' %}

<div class="ces-section ces-experience-list{% if section.settings.tick_style == 'outline' %} ces-experience-list--outline{% endif %}{% unless section.settings.show_dividers %} ces-experience-list--no-rules{% endunless %}{% if section.settings.columns_desktop == '1' %} ces-experience-list--one-col{% endif %} ces-section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="ces-section__inner ces-section__inner--narrow">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="ces-section__header">
        {%- if section.settings.heading != blank -%}
          {%- liquid
            assign xl_heading = section.settings.heading
            assign xl_accent = section.settings.heading_accent | strip
            if xl_accent != blank and xl_heading contains xl_accent
              capture xl_wrapped
                echo '<span class="ces-experience-list__accent">'
                echo xl_accent
                echo '</span>'
              endcapture
              assign xl_heading = xl_heading | replace: xl_accent, xl_wrapped
            endif
          -%}
          <h2 class="ces-heading">{{ xl_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="ces-subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="ces-experience-list__grid">
        {%- for block in section.blocks -%}
          {%- if block.settings.text != blank -%}
            <li class="ces-experience-list__item" {{ block.shopify_attributes }}>
              <span class="ces-experience-list__check" aria-hidden="true">
                <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1.5 6.2 4.4 9l6-6.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span class="ces-experience-list__text">{{ block.settings.text }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.image != blank -%}
      <figure class="ces-experience-list__figure">
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          alt="{{ section.settings.image_alt | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
        >
        {%- if section.settings.image_caption != blank -%}
          <figcaption class="ces-experience-list__caption">{{ section.settings.image_caption }}</figcaption>
        {%- endif -%}
      </figure>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "CES Experience List",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed around what people dislike about ordinary eye patches"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "tick_style",
      "label": "Tick style",
      "options": [
        { "value": "filled", "label": "Filled disc" },
        { "value": "outline", "label": "Thin ring" }
      ],
      "default": "filled"
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "Rule between the points",
      "default": true
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "Two" },
        { "value": "1", "label": "One" }
      ],
      "default": "2"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Part of the heading to colour",
      "info": "Type the words exactly as they appear in the heading."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image under the list"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description"
    },
    {
      "type": "text",
      "id": "image_caption",
      "label": "Caption"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "List point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Stays where you place it during normal upright activity."
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "CES Experience List",
      "blocks": [
        { "type": "item", "settings": { "text": "Stays where you place it during normal upright activity." } },
        { "type": "item", "settings": { "text": "Dry micro-cone format—not a wet gel patch." } },
        { "type": "item", "settings": { "text": "Removes cleanly without a sticky film." } },
        { "type": "item", "settings": { "text": "Individually sealed treatment pouches." } },
        { "type": "item", "settings": { "text": "Designed for comfortable use when directions are followed." } },
        { "type": "item", "settings": { "text": "Fits into a makeup routine after removal." } }
      ]
    }
  ]
}
{% endschema %}
