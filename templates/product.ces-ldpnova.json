    "howto": {
      "type": "ces-usage-steps",
      "settings": {
        "heading": "2 Minutes Before Bed. Wake Up To Already-Done Results.",
        "subheading": "",
        "note": "<p>The overnight timing matters more than it sounds. When you sleep flat your face is horizontal for 6 to 8 hours. That is when fluid builds under your eyes, and when the tissue is most receptive. <strong>CEBEAM works during those exact hours</strong>, not in the morning when the damage is already done.</p>",
        "color_scheme": "scheme-1",
        "padding_top": 32,
        "padding_bottom": 40
      },
      "blocks": {
        "step-1": {
          "type": "step",
          "settings": {
            "image": "",
            "title": "Cleanse",
            "text": "Gently wash your face before bed. Clean skin helps the cones dissolve better."
          }
        },
        "step-2": {
          "type": "step",
          "settings": {
            "image": "",
            "title": "Apply",
            "text": "Press one patch under each eye. You will feel a light tingle for a few seconds. Then nothing."
          }
        },
        "step-3": {
          "type": "step",
          "settings": {
            "image": "",
            "title": "Peel Off In The Morning",
            "text": "Remove the patches when you wake up. The work happened while you slept. Use them twice a week."
          }
        }
      },
