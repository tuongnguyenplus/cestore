    "mechanism": {
      "type": "ces-image-text-banner",
      "settings": {
        "image": "",
        "layout": "image_first",
        "image_shape": "rounded",
        "text_position": "middle",
        "overlay_opacity": 0,
        "eyebrow": "How it Works",
        "heading_accent": "",
        "heading": "Meet The Patch That Crosses The Wall",
        "text": "<p>CEBEAM Patches don't sit on your skin. They dissolve into it.</p><p>Each patch carries hundreds of tiny cones made from hyaluronic acid and peptides. Press one under your eye before bed. The cones dissolve painlessly beneath the surface over several hours, reaching the deeper layer where eye bags actually form.</p><p>You sleep. They work. Peel them off in the morning.</p><p>That is it. No routine. No reapplying. No waiting for something to soak in that never will.</p>",
        "button_label": "Get Now & Save 70%",
        "button_link": "#shopify-section-main",
        "badge_speed": 40,
        "color_scheme": "scheme-1",
        "padding_top": 40,
        "padding_bottom": 40
      }
    },
