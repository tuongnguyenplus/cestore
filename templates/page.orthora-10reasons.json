          "type": "reason",
          "settings": {
            "image_position": "top",
            "heading": "What I had already spent, before I spent this",
            "body": "<p><strong>$45</strong> on the black bottle. <strong>$22</strong> on the roller in the drawer. <strong>$3,000–$6,000</strong> quoted for surgery, plus <strong>7–10 days</strong> off work. Two years of being read as tired, annoyed, or slowing down.</p><p>Cebeam is <strong>[XX]</strong> — [X pairs, roughly X weeks at two nights a week]. Less than one round of drinks with clients, and no days off work.</p>"
          }
