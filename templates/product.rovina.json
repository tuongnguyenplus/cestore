    "faq": {
      "type": "ces-faq-accordion",
      "blocks": {
        "faq-1": {
          "type": "faq_item",
          "settings": {
            "question": "How long until I see results?",
            "answer": "<p>Hydration and a smoother look are often visible the next morning. Changes to bags, dark circles and lines usually build over 1–2 weeks of regular use.*</p>",
            "open": false
          }
        },
        "faq-2": {
          "type": "faq_item",
          "settings": {
            "question": "Do the patches hurt?",
            "answer": "<p>No. You may feel a light tingle for a minute or two as the painless micro-cones make contact and soften. The sensation fades quickly.</p>",
            "open": false
          }
        },
        "faq-3": {
          "type": "faq_item",
          "settings": {
            "question": "How often should I use them?",
            "answer": "<p>Two to three nights a week is all you need. The actives keep working between uses, so there’s no need to apply every night.</p>",
            "open": false
          }
        },
        "faq-4": {
          "type": "faq_item",
          "settings": {
            "question": "Are they safe for sensitive skin?",
            "answer": "<p>Yes. The formula is dermatologist-tested and made for the delicate eye area. If your skin is very reactive, do a small patch test first.</p>",
            "open": false
          }
        },
        "faq-5": {
          "type": "faq_item",
          "settings": {
            "question": "How do I apply them?",
            "answer": "<p>On clean, dry skin, place one under each eye and press firmly for 5–10 seconds. Leave on at least 2 hours, or overnight, then remove in the morning.</p>",
            "open": false
          }
        },
        "faq-6": {
          "type": "faq_item",
          "settings": {
            "question": "Why do the patches feel dry to the touch?",
            "answer": "<p>That’s normal. The micro-cones are crystallised, solidified actives — not a soaked serum — so there’s no visible liquid. The dry feel is part of how they work.</p>",
            "open": false
          }
        },
        "faq-7": {
          "type": "faq_item",
          "settings": {
            "question": "A little redness after use — is that normal?",
            "answer": "<p>Yes, and it’s a good sign. It means the micro-cones delivered the actives where they’re needed. It usually settles within 15–30 minutes.</p>",
            "open": false
          }
        },
        "faq-8": {
          "type": "faq_item",
          "settings": {
            "question": "Can I wear makeup afterwards?",
            "answer": "<p>Yes — after removing the patch, wait about 20 minutes, then apply concealer as normal. Many people find it sits smoother on the days after.</p>",
            "open": false
          }
        },
        "faq-9": {
          "type": "faq_item",
          "settings": {
            "question": "Will this work on bags I’ve had for years?",
            "answer": "<p>Often, partly — it depends what’s under there. Fluid, thin skin and lost firmness respond well. Inherited fat pads that push forward are a surgical issue no topical can move.*</p>",
            "open": false
          }
        },
        "faq-10": {
          "type": "faq_item",
          "settings": {
            "question": "Can I buy Cebeam in stores?",
            "answer": "<p>Not currently. It’s sold direct so we can control storage and freshness.</p>",
            "open": false
          }
        },
        "faq-11": {
          "type": "faq_item",
          "settings": {
            "question": "Who should not use these?",
            "answer": "<p>Skip them on broken, irritated or sunburned skin, or with an active eye infection. If you’re pregnant, nursing or on prescription retinoids, ask your doctor first.*</p>",
            "open": false
          }
        },
        "faq-12": {
          "type": "faq_item",
          "settings": {
            "question": "How should I store them?",
            "answer": "<p>Sealed, somewhere cool and dry, out of direct sun. Don’t refrigerate — condensation ruins the micro-cones. Once a patch is out of its pouch, use it.</p>",
            "open": false
          }
        },
        "faq-13": {
          "type": "faq_item",
          "settings": {
            "question": "What if it doesn’t work for me?",
            "answer": "<p>Contact us within 90 days for a full refund. You don’t need to send the box back.</p>",
            "open": false
          }
        }
      },
