    "faq": {
      "type": "ces-faq-accordion",
      "blocks": {
        "faq-science-1": {
          "type": "faq_item",
          "settings": {
            "group_label": "How it works",
            "question": "How is this different from an eye cream?",
            "answer": "<p>A cream sits on the surface, where most of it evaporates. CEBEAM's micro-cones dissolve below the barrier and deposit the actives into the layers where lines and dark circles form.</p>",
            "open": false
          }
        },
        "faq-9": {
          "type": "faq_item",
          "settings": {
            "group_label": "Before you buy",
            "question": "Will this work on bags I’ve had for years?",
            "answer": "<p>Often, partly — it depends what’s under there. Fluid, thin skin and lost firmness respond well. Inherited fat pads that push forward are a surgical issue no topical can move.*</p>",
            "open": false
          }
        },
        "faq-10": {
          "type": "faq_item",
          "settings": {
            "group_label": "",
            "question": "Can I buy Cebeam in stores?",
            "answer": "<p>Not currently. It’s sold direct so we can control storage and freshness.</p>",
            "open": false
          }
        },
        "faq-5": {
          "type": "faq_item",
          "settings": {
            "group_label": "How to use them",
            "question": "How do I apply them?",
            "answer": "<p>On clean, dry skin, place one under each eye and press firmly for 5–10 seconds. Leave on at least 2 hours, or overnight, then remove in the morning.</p>",
            "open": false
