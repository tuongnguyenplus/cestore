        "text_position": "center",
        "overlay_opacity": 40,
        "eyebrow": "THE SCIENCE",
        "heading_accent": "CEBEAM",
        "heading": "The Science Behind",
        "text": "<p>We combined self-dissolving microneedle technology with a clinically guided peptide complex into one effortless patch — shown to smooth fine lines, de-puff, and rebuild firmer under-eye skin.</p>",
        "button_label": "",
        "button_link": "",
        "badge_speed": 40,
        "color_scheme": "scheme-1",
        "padding_top": 56,
        "padding_bottom": 24
      }
