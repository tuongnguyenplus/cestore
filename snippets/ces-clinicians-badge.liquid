{%- comment -%}
  ces-clinicians-badge
  Renders the "Clinicians' Choice" (FrontrowMD-style) badge.

  Accepts:
    - block:   the ces_clinicians block
    - variant: 'inline' (default, sits in the product info column) or
               'top' (a dismissible floating card above the media gallery)

  The "top" variant has an expanded and a collapsed state; the close (x)
  button collapses it, clicking the collapsed pill expands it again, and the
  choice is remembered per-browser. Both variants open the shared Clinician
  reviews modal via the `ces:open-clinreviews` event.
{%- endcomment -%}
{%- assign ces_variant = variant | default: 'inline' -%}

{%- if ces_variant == 'top' -%}
  <div
    class="ces-clinicians ces-clinicians--top"
    data-ces-clin-card
    data-storage-key="cesClinBadge-{{ block.id }}"
    {{ block.shopify_attributes }}
  >
    <button type="button" class="ces-clinicians__close" data-ces-clin-collapse aria-label="Dismiss">
      <svg viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    </button>

    <div class="ces-clinicians__expanded">
      {%- if block.settings.eyebrow != blank -%}
        <div class="ces-clinicians__badge-mark">
          <span class="ces-clinicians__laurel ces-clinicians__laurel--left" aria-hidden="true">
            {{- 'ces-clin-laurel-left.svg' | inline_asset_content -}}
          </span>
          <p class="ces-clinicians__title">{{ block.settings.eyebrow }}</p>
          <span class="ces-clinicians__laurel ces-clinicians__laurel--right" aria-hidden="true">
            {{- 'ces-clin-laurel-right.svg' | inline_asset_content -}}
          </span>
        </div>
      {%- endif -%}

      <div class="ces-clinicians__badge-body">
        {%- if block.settings.text != blank -%}
          <div class="ces-clinicians__copy">{{ block.settings.text }}</div>
        {%- endif -%}

        <div class="ces-clinicians__cta">
          {%- if block.settings.avatar_1 != blank or block.settings.avatar_2 != blank or block.settings.avatar_3 != blank -%}
            <span class="ces-clinicians__avatars" aria-hidden="true">
              {%- for ces_clin_i in (1..3) -%}
                {%- assign ces_clin_key = 'avatar_' | append: ces_clin_i -%}
                {%- assign ces_clin_img = block.settings[ces_clin_key] -%}
                {%- if ces_clin_img != blank -%}
                  {{
                    ces_clin_img
                    | image_url: width: 60
                    | image_tag: loading: 'lazy', widths: '20, 40, 60', sizes: '20px', class: 'ces-clinicians__avatar', alt: ''
                  }}
                {%- endif -%}
              {%- endfor -%}
            </span>
          {%- endif -%}

          {%- if block.settings.top_link_label != blank -%}
            <button
              type="button"
              class="ces-clinicians__inline-link"
              onclick="document.dispatchEvent(new CustomEvent('ces:open-clinreviews',{bubbles:true,detail:{view:'main'}}))"
            >{{ block.settings.top_link_label }}</button>
          {%- endif -%}
        </div>
      </div>
    </div>

    {%- comment -%} Collapsed state: just the mark; click to expand again. {%- endcomment -%}
    <button type="button" class="ces-clinicians__collapsed" data-ces-clin-expand aria-label="{{ block.settings.eyebrow }}" hidden>
      <span class="ces-clinicians__badge-mark">
        <span class="ces-clinicians__laurel ces-clinicians__laurel--left" aria-hidden="true">
          {{- 'ces-clin-laurel-left.svg' | inline_asset_content -}}
        </span>
        <span class="ces-clinicians__title">{{ block.settings.eyebrow }}</span>
        <span class="ces-clinicians__laurel ces-clinicians__laurel--right" aria-hidden="true">
          {{- 'ces-clin-laurel-right.svg' | inline_asset_content -}}
        </span>
      </span>
    </button>
  </div>

{%- else -%}
  <div class="ces-clinicians quick-add-hidden" {{ block.shopify_attributes }}>
    {%- if block.settings.eyebrow != blank -%}
      <div class="ces-clinicians__heading">
        <span class="ces-clinicians__laurel ces-clinicians__laurel--left" aria-hidden="true">
          {{- 'ces-clin-laurel-left.svg' | inline_asset_content -}}
        </span>
        <span class="ces-clinicians__caduceus" aria-hidden="true">
          {{- 'ces-clin-caduceus.svg' | inline_asset_content -}}
        </span>
        <p class="ces-clinicians__title">{{ block.settings.eyebrow }}</p>
        <span class="ces-clinicians__laurel ces-clinicians__laurel--right" aria-hidden="true">
          {{- 'ces-clin-laurel-right.svg' | inline_asset_content -}}
        </span>
      </div>
    {%- endif -%}

    {%- if block.settings.text != blank -%}
      <div class="ces-clinicians__copy">
        {{ block.settings.text }}
        {%- if block.settings.learn_more_label != blank -%}
          <button
            type="button"
            class="ces-clinicians__inline-link"
            onclick="document.dispatchEvent(new CustomEvent('ces:open-clinreviews',{bubbles:true,detail:{view:'main'}}))"
          >{{ block.settings.learn_more_label }}</button>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if block.settings.reviews_label != blank -%}
      <div class="ces-clinicians__cta">
        {%- if block.settings.avatar_1 != blank or block.settings.avatar_2 != blank or block.settings.avatar_3 != blank -%}
          <span class="ces-clinicians__avatars" aria-hidden="true">
            {%- for ces_clin_i in (1..3) -%}
              {%- assign ces_clin_key = 'avatar_' | append: ces_clin_i -%}
              {%- assign ces_clin_img = block.settings[ces_clin_key] -%}
              {%- if ces_clin_img != blank -%}
                {{
                  ces_clin_img
                  | image_url: width: 60
                  | image_tag: loading: 'lazy', widths: '20, 40, 60', sizes: '20px', class: 'ces-clinicians__avatar', alt: ''
                }}
              {%- endif -%}
            {%- endfor -%}
          </span>
        {%- endif -%}

        <button
          type="button"
          class="ces-clinicians__reviews-link"
          onclick="document.dispatchEvent(new CustomEvent('ces:open-clinreviews',{bubbles:true,detail:{view:'reviews'}}))"
        >
          {{ block.settings.reviews_label }}
          <svg viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M1.5 1 6.5 6l-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}
