{% comment %}
  Renders an inline SVG icon for the ces-* sections.

  Where Dawn already ships a suitable icon it is inlined from the theme assets
  so there is one source of truth; the handful Dawn has no equivalent for are
  defined here. All icons inherit the current text colour.

  Accepts:
  - icon: {String} Icon name. One of: check, check-circle, cross, cross-circle,
      check-ring, shield, star, star-filled, star-half, caret, chevron-left, chevron-right, truck, lock, return, leaf,
      plane, plant, recycle, heart, stopwatch, lightning, fire, info,
      question-mark, gluten-free, dairy-free, nut-free, play, pause.
  - size: {String} Optional CSS length for width/height. Default 2rem.
  - class: {String} Optional extra class names on the wrapper.

  Usage:
  {% render 'ces-icon', icon: 'check-circle', size: '2.4rem', class: 'ces-icon--success' %}
{% endcomment %}

{%- liquid
  case icon
    when 'check'
      assign asset_file = 'icon-checkmark.svg'
    when 'cross'
      assign asset_file = 'icon-close.svg'
    when 'star'
      assign asset_file = 'icon-star.svg'
    when 'caret'
      assign asset_file = 'icon-caret.svg'
    when 'truck'
      assign asset_file = 'icon-truck.svg'
    when 'lock'
      assign asset_file = 'icon-padlock.svg'
    when 'return'
      assign asset_file = 'icon-return.svg'
    when 'leaf'
      assign asset_file = 'icon-leaf.svg'
    when 'plane'
      assign asset_file = 'icon-plane.svg'
    when 'plant'
      assign asset_file = 'icon-plant.svg'
    when 'recycle'
      assign asset_file = 'icon-recycle.svg'
    when 'heart'
      assign asset_file = 'icon-heart.svg'
    when 'stopwatch'
      assign asset_file = 'icon-stopwatch.svg'
    when 'lightning'
      assign asset_file = 'icon-lightning-bolt.svg'
    when 'fire'
      assign asset_file = 'icon-fire.svg'
    when 'info'
      assign asset_file = 'icon-info.svg'
    when 'question-mark'
      assign asset_file = 'icon-question-mark.svg'
    when 'gluten-free'
      assign asset_file = 'icon-gluten-free.svg'
    when 'dairy-free'
      assign asset_file = 'icon-dairy-free.svg'
    when 'nut-free'
      assign asset_file = 'icon-nut-free.svg'
    when 'play'
      assign asset_file = 'icon-play.svg'
    when 'pause'
      assign asset_file = 'icon-pause.svg'
  endcase
-%}

<span
  class="ces-icon{% if class != blank %} {{ class }}{% endif %}"
  {% if size != blank %}
    style="--ces-icon-size: {{ size }};"
  {% endif %}
  aria-hidden="true"
>
  {%- if asset_file != blank -%}
    {{- asset_file | inline_asset_content -}}
  {%- else -%}
    {%- case icon -%}
      {%- when 'check-circle' -%}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none">
          <circle cx="10" cy="10" r="10" fill="currentColor"/>
          <path class="ces-icon__mark" d="m5.8 10.3 2.6 2.6 5.8-5.8" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      {%- when 'star-half' -%}
        {%- comment -%} Left half solid, right half outlined — for a x.5 rating. {%- endcomment -%}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
          <defs><clipPath id="ces-half"><rect x="0" y="0" width="10" height="20"/></clipPath></defs>
          <path fill="none" stroke="currentColor" stroke-width="1.3" d="M10 2.2l2.24 4.85 5.31.61-3.94 3.6 1.05 5.22L10 13.9l-4.66 2.58 1.05-5.22-3.94-3.6 5.31-.61z"/>
          <path fill="currentColor" clip-path="url(#ces-half)" d="M10 1.4l2.47 5.35 5.85.67-4.34 3.98 1.16 5.76L10 14.3l-5.14 2.86 1.16-5.76L1.68 7.42l5.85-.67z"/>
        </svg>
      {%- when 'star-filled' -%}
        {%- comment -%}
          Dawn's star is an outline. A rating reads as weaker than it is when the
          stars are hollow, so this one is solid.
        {%- endcomment -%}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
          <path fill="currentColor" d="M10 1.4l2.47 5.35 5.85.67-4.34 3.98 1.16 5.76L10 14.3l-5.14 2.86 1.16-5.76L1.68 7.42l5.85-.67z"/>
        </svg>
      {%- when 'shield' -%}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none">
          <path d="M10 1.6 3.2 4.2v5.3c0 4 2.9 7.6 6.8 8.9 3.9-1.3 6.8-4.9 6.8-8.9V4.2z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
          <path d="m6.9 9.9 2.2 2.2 4.2-4.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      {%- when 'check-ring' -%}
        {%- comment -%}
          Outlined ring rather than a filled disc, so it reads correctly when
          placed inside a coloured circle of its own.
        {%- endcomment -%}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none">
          <circle cx="10" cy="10" r="8.6" stroke="currentColor" stroke-width="1.4"/>
          <path d="m6.2 10.2 2.5 2.5 5.2-5.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      {%- when 'cross-circle' -%}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none">
          <circle cx="10" cy="10" r="10" fill="currentColor"/>
          <path class="ces-icon__mark" d="m6.8 6.8 6.4 6.4M13.2 6.8l-6.4 6.4" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      {%- when 'chevron-left' -%}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none">
          <path d="M12.5 3.5 6 10l6.5 6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      {%- when 'chevron-right' -%}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none">
          <path d="M7.5 3.5 14 10l-6.5 6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      {%- when 'sparkle' -%}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
          <path fill="currentColor" d="M10 0c.5 3.9 1.6 6.5 3.2 8.1C14.8 9.7 17 10 20 10c-3 0-5.2.3-6.8 1.9C11.6 13.5 10.5 16.1 10 20c-.5-3.9-1.6-6.5-3.2-8.1C5.2 10.3 3 10 0 10c3 0 5.2-.3 6.8-1.9C8.4 6.5 9.5 3.9 10 0Z"/>
        </svg>

      {%- comment -%} Thematic wellness line icons for the feature grid. {%- endcomment -%}
      {%- when 'cell-defense' -%}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
          <path d="M12 2.6 19.5 7v10L12 21.4 4.5 17V7z"/>
          <circle cx="12" cy="12" r="4.2"/>
          <path d="M12 9.8c1.6 0 2.9 1 2.9 2.6 0 1.3-1.3 2.4-2.9 2.4-.1-1.4-.1-3.6 0-5z" fill="currentColor" stroke="none"/>
          <path d="M9.2 12.4c1 .3 1.9.9 2.6 1.8" stroke-linecap="round"/>
          <circle cx="12" cy="2.6" r="1.2" fill="currentColor" stroke="none"/>
          <circle cx="19.5" cy="7" r="1.2" fill="currentColor" stroke="none"/>
          <circle cx="19.5" cy="17" r="1.2" fill="currentColor" stroke="none"/>
          <circle cx="12" cy="21.4" r="1.2" fill="currentColor" stroke="none"/>
          <circle cx="4.5" cy="17" r="1.2" fill="currentColor" stroke="none"/>
          <circle cx="4.5" cy="7" r="1.2" fill="currentColor" stroke="none"/>
        </svg>

      {%- when 'molecule' -%}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
          <path d="M8.4 8.4 5.6 5.6M15.6 8.4l2.8-2.8M8.6 12h6.8M8.4 15.6l-2.8 2.8M15.6 15.6l2.8 2.8"/>
          <circle cx="12" cy="12" r="2.6" fill="currentColor" stroke="none"/>
          <circle cx="4.4" cy="4.4" r="2.2"/>
          <circle cx="19.6" cy="4.4" r="2.2"/>
          <circle cx="4.4" cy="19.6" r="2.2"/>
          <circle cx="19.6" cy="19.6" r="2.2"/>
        </svg>

      {%- when 'vitality' -%}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="4.6" r="2" fill="currentColor" stroke="none"/>
          <path d="M4.5 9.5c2.4 1.4 4.9 2.1 7.5 2.1s5.1-.7 7.5-2.1"/>
          <path d="M12 11.6v4M12 15.6 7.6 21M12 15.6 16.4 21"/>
          <path d="M6.5 5.5C7 4 7.8 3 9 2.6M17.5 5.5C17 4 16.2 3 15 2.6"/>
        </svg>

      {%- when 'inflammation' -%}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
          <path d="M3 13.5c3-2 6-2 9 0s6 2 9 0" stroke-width="1.6"/>
          <path d="M3 17.5c3-2 6-2 9 0s6 2 9 0" stroke-width="1.6"/>
          <circle cx="8" cy="20.6" r="0.7" fill="currentColor" stroke="none"/>
          <circle cx="12" cy="21" r="0.7" fill="currentColor" stroke="none"/>
          <circle cx="16" cy="20.6" r="0.7" fill="currentColor" stroke="none"/>
          <path d="M12 9.5V3M12 3l-2 2.4M12 3l2 2.4M8 10 6.4 6.6M16 10l1.6-3.4"/>
        </svg>

      {%- when 'heart-plus' -%}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
          <path d="M12 20.5C7 17 3.5 13.8 3.5 9.6 3.5 6.9 5.6 5 8 5c1.7 0 3.1.9 4 2.3C12.9 5.9 14.3 5 16 5c2.4 0 4.5 1.9 4.5 4.6 0 4.2-3.5 7.4-8.5 10.9z"/>
          <path d="M12 10v4M10 12h4" stroke-linecap="round" stroke-width="1.5"/>
        </svg>

      {%- when 'skin-aging' -%}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
          <path d="M3 14c3-2 6-2 9 0s6 2 9 0" stroke-width="1.6"/>
          <path d="M3 18c3-2 6-2 9 0s6 2 9 0" stroke-width="1.6"/>
          <path d="M7 9.5V4M7 4 5.4 5.8M7 4l1.6 1.8"/>
          <path d="M12 9V2.5M12 2.5 10.2 4.4M12 2.5l1.8 1.9"/>
          <path d="M17 9.5V4M17 4l-1.6 1.8M17 4l1.6 1.8"/>
        </svg>
    {%- endcase -%}
  {%- endif -%}
</span>
