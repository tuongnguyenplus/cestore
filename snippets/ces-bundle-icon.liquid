{%- comment -%} ces-bundle-icon — small inline icons for bundle inclusion rows. Accepts: name {%- endcomment -%}
{%- case name -%}
  {%- when 'gift' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12v9H4v-9M2 7h20v5H2zM12 22V7M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
  {%- when 'truck' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M1 3h15v13H1zM16 8h4l3 3v5h-7M5.5 19a2 2 0 1 0 0-.01M18.5 19a2 2 0 1 0 0-.01"/></svg>
  {%- when 'coin', 'money', 'guarantee' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M9.5 9.5a2.5 2.5 0 0 1 5 0c0 1.5-1 2-2.5 2.5s-2.5 1-2.5 2.5a2.5 2.5 0 0 0 5 0"/></svg>
  {%- when 'doc', 'ebook', 'protocol', 'guide' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H6v18h12V7zM14 3v4h4M8 12h8M8 16h8M8 8h3"/></svg>
  {%- when 'tracker', 'clipboard', 'photo' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4H5v17h14V4h-3M9 4a3 3 0 0 1 6 0M8.5 12l2 2 4-4"/></svg>
  {%- when 'clock', 'time' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
  {%- when 'star' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.6 5.6 6 .7-4.4 4.2 1.2 6-5.4-3-5.4 3 1.2-6L3.4 9.3l6-.7z"/></svg>
  {%- when 'leaf' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20C3 12 8 4 20 4c0 12-8 16-16 15zM4 20c4-6 8-8 12-9"/></svg>
  {%- when 'patches', 'eyepatch', 'patch', 'treatment', 'treatments' -%}
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M3.2 6.6C4.5 3.4 9.7 2.1 14.5 3.6c3 .9 5 2.6 5 4.3 0 1.7-2 2.3-4.7 1.5C10.9 8.1 6.9 8.9 4.7 11.5 3.3 10.4 2.5 8.4 3.2 6.6Z"/><path d="M20.8 17.4C19.5 20.6 14.3 21.9 9.5 20.4c-3-.9-5-2.6-5-4.3 0-1.7 2-2.3 4.7-1.5 3.9 1.3 7.9.5 10.1-2.1 1.4 1.1 2.2 3.1 1.5 4.9Z"/></svg>
  {%- else -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
{%- endcase -%}
