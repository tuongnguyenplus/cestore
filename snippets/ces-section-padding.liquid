{% comment %}
  Emits the per-section padding rule used by every ces- section, matching the
  scale Dawn applies in its own sections (75% of the chosen value below 750px).

  Expects the enclosing section to define `padding_top` and `padding_bottom`
  range settings, and its root element to carry `ces-section-{{ section.id }}-padding`.

  Usage:
  {% render 'ces-section-padding' %}
{% endcomment %}

{%- style -%}
  .ces-section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .ces-section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
